     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b"}], "}"}]}], ",", " ", 
    RowBox[{"PlotStyle", "\[Rule]", "Red"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "x", "]"}], "/.", 
     RowBox[{"x", "\[Rule]", 
      RowBox[{"Range", "[", 
