    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"0", ",", " ", "8"}], "}"}]}], ",", " ", 
    RowBox[{"Filling", "\[Rule]", "Axis"}], ",", " ", 
    RowBox[{"DataRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b"}], "}"}]}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
