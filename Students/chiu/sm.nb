Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", "<", "x", "<", "7.5"}], ",", " ", 
       RowBox[{"Log", "[", "x", "]"}]}], "]"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", "<", "x", "<", "15"}], ",", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"x", "/", "2"}], "]"}]}], "]"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", "<", "x", "<", 
        RowBox[{"2", 
         SuperscriptBox["\[ExponentialE]", "0.5"]}]}], ",", " ", "0.5"}], 
      "]"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", "<", "x", "<", 
        RowBox[{"2", "\[ExponentialE]"}]}], ",", " ", "1"}], "]"}], ",", " ", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", "<", "x", "<", 
        RowBox[{"2", 
         SuperscriptBox["\[ExponentialE]", "1.5"]}]}], ",", " ", "1.5"}], 
      "]"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", "<", "x", "<", 
        RowBox[{"2", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", "0.5"}]]}]}], ",", " ", 
       RowBox[{"-", "0.5"}]}], "]"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"0", "<", "x", "<", 
        RowBox[{"2", 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", "1"}]]}]}], ",", " ", 
       RowBox[{"-", "1"}]}], "]"}]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "1"}], ",", " ", "15"}], "}"}], ",", " ", 
   RowBox[{"PlotRange", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1.5"}], ",", " ", "2"}], "}"}]}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "Blue", ",", " ", "Red", ",", " ", "LightGray", ",", " ", "LightGray", 
