      RowBox[{"Range", "[", 
       RowBox[{"a", ",", " ", "b", ",", " ", "h"}], "]"}]}]}], ",", 
    RowBox[{"Filling", "\[Rule]", "Axis"}], ",", " ", 
    RowBox[{"PlotRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"c", ",", " ", "d"}], "}"}]}], ",", " ", 
    RowBox[{"DataRange", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"a", ",", " ", "b"}], "}"}]}], ",", " ", 
    RowBox[{"PlotStyle", "\[Rule]", "Orange"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ListPlot", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "/.", 
     RowBox[{"x", "\[Rule]", 
      RowBox[{"Range", "[", 
       RowBox[{"a", ",", " ", "b", ",", " ", "h"}], "]"}]}]}], ",", 
    RowBox[{"Filling", "\[Rule]", "Axis"}], ",", " ", 
    RowBox[{"PlotRange", "\[Rule]", 
