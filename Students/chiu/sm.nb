Cell[CellGroupData[{

Cell["8 Perfect Faro Shuffles  ", "Section",
 CellChangeTimes->{{3.5404613289658403`*^9, 3.5404613303879223`*^9}}],

Cell["\<\
It\[CloseCurlyQuote]s said that if a deck is perfectly shuffled eight times, \
the cards will be in the same order as they were before the shuffling.
Here is an experiment on it. \
\>", "Text",
 CellChangeTimes->{{3.540461254785598*^9, 3.5404613108368034`*^9}, {
  3.540461376583564*^9, 3.540461394812607*^9}}],

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"(*", " ", 
    RowBox[{"shuffle", " ", "function"}], " ", "*)"}],
   FontColor->RGBColor[1, 0, 0]], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Clear", "[", 
     RowBox[{"f", ",", " ", "aaa"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "aaa_", "]"}], ":=", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"aaa", "[", 
            RowBox[{"[", 
             RowBox[{"Range", "[", 
              RowBox[{"1", ",", " ", 
               FractionBox[
                RowBox[{"Length", "[", "aaa", "]"}], "2"]}], "]"}], "]"}], 
            "]"}], ",", " ", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"{", 
              FractionBox[
               RowBox[{"Length", "[", "aaa", "]"}], "2"], "}"}]}], "]"}]}], 
          "}"}], "//", "Transpose"}], "//", "Flatten"}], ")"}], "+", 
      "\[IndentingNewLine]", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"aaa", "[", 
             RowBox[{"[", 
              RowBox[{"Range", "[", 
               RowBox[{
                RowBox[{
                 FractionBox[
                  RowBox[{"Length", "[", "aaa", "]"}], "2"], "+", "1"}], ",", 
                " ", 
                RowBox[{"Length", "[", "aaa", "]"}]}], "]"}], "]"}], "]"}], 
            ",", " ", 
            RowBox[{"Table", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"{", 
               FractionBox[
                RowBox[{"Length", "[", "aaa", "]"}], "2"], "}"}]}], "]"}]}], 
           "}"}], "//", "Transpose"}], "//", "Flatten"}], "//", 
        "RotateRight"}], ")"}]}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.540461406616282*^9, 3.540461422160171*^9}, {
  3.540463945993526*^9, 3.5404639528779197`*^9}}],

