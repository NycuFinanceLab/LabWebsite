Cell[CellGroupData[{

Cell["Magic Square of Order 3", "Section",
 CellChangeTimes->{{3.5241039064351225`*^9, 3.5241039160915403`*^9}, 
   3.5241051030675335`*^9, {3.5404642762714167`*^9, 3.5404642905662346`*^9}}],

Cell["\<\
Put 1, 2, 3, ..., 9 into different cells such that the sums of the 3 numbers \
of all rows, all columns, and both diagonals are the same. 
The answer is well-known, but the derivation is not. 
Here is the derivation. \
\>", "Text",
 CellChangeTimes->{{3.5241036898250036`*^9, 3.52410371563048*^9}, {
   3.5404644956499643`*^9, 3.5404645228555202`*^9}, {3.54046456201276*^9, 
   3.5404646153588114`*^9}, 3.5404647208688464`*^9, {3.5404659158011923`*^9, 
   3.5404659634369173`*^9}}],

