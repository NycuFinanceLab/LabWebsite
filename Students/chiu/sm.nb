    RowBox[{
     RowBox[{"f", "[", "x", "]"}], "/.", 
     RowBox[{"x", "\[Rule]", 
      RowBox[{"Range", "[", 
       RowBox[{"a", ",", " ", "b", ",", " ", "0.5"}], "]"}]}]}], ",", 
    RowBox[{"Filling", "\[Rule]", "Axis"}], ",", " ", 
    RowBox[{"PlotRange", "\[Rule]", 
