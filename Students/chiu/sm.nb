   3.5241067910467844`*^9, 3.540465759349244*^9}]
}, Open  ]],

Cell[TextData[{
 "Let ",
 Cell[BoxData[
  FormBox["a", TraditionalForm]],
  FormatType->"TraditionalForm"],
 " be the number in the yellow cell, \n",
 Cell[BoxData[
  FormBox["b", TraditionalForm]],
  FormatType->"TraditionalForm"],
 " be the sum of all numbers in the blue cells, \nand ",
 Cell[BoxData[
  FormBox["c", TraditionalForm]],
  FormatType->"TraditionalForm"],
 " be the sum of all numbers in the red cells. \n\nSince the sum of all 9 \
numbers equals 45, the numbers in every row (column) have the sum 15. \nThus, \
we have \n\n",
 Cell[BoxData[{
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"4", "a"}], "+", 
     RowBox[{"3", "b"}], "+", 
     RowBox[{"2", "c"}]}], "=", "120"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{"a", "+", "b", "+", "c"}], "=", "45"}], 
   TraditionalForm], "\[IndentingNewLine]", 
  FormBox[
   RowBox[{
    RowBox[{
     RowBox[{"2", "a"}], "+", "b"}], "=", "30"}], TraditionalForm]}]],
 "\n\nand hence ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"a", "=", "5"}], ",", " ", 
    RowBox[{"b", "=", 
     RowBox[{"c", "=", "20"}]}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ". \n\nNow that ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "=", "5"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", we look for all pairs of numbers that have the sum 10. \nThere are 4 such \
pairs. \nFind 3 numbers from 3 different pairs such that their sum is 15. \n\
There are 4 this kind of tuples. \nThey are just the four edges of the \
square. \n\nThe above argument only works for order 3. "
}], "Text",
 CellChangeTimes->{{3.5241039538748064`*^9, 3.5241041364100943`*^9}, {
  3.5241042155106187`*^9, 3.5241042192548327`*^9}, {3.5241044490569735`*^9, 
  3.524104485342637*^9}, {3.5241045220027018`*^9, 3.524104584137611*^9}, {
  3.5241055728703566`*^9, 3.524105750914278*^9}, {3.5241058266566105`*^9, 
  3.524105850637982*^9}, {3.5404647999443693`*^9, 3.5404650574160957`*^9}, {
  3.5404651071839423`*^9, 3.540465155468704*^9}, {3.5404652454598513`*^9, 
  3.540465269648235*^9}, {3.5404653069703693`*^9, 3.5404654133054514`*^9}, {
  3.5404656239314985`*^9, 3.5404656258566084`*^9}, {3.5404656797596917`*^9, 
  3.5404657835576286`*^9}, {3.5404658139393663`*^9, 3.540465817010542*^9}, {
  3.540465860460027*^9, 3.5404658791090937`*^9}, {3.5404660103666015`*^9, 
  3.5404660108096266`*^9}}]
}, Closed]],

Cell[CellGroupData[{

Cell["Catenary & Parabola", "Section",
 CellChangeTimes->{{3.5404638732913675`*^9, 3.5404638873611727`*^9}}],

Cell["\<\
It\[CloseCurlyQuote]s said (by Johann Bernoulli) that Jacob Bernoulli thought \
a catenary is a parabola. 
Here is the plots of both. \
\>", "Text",
 CellChangeTimes->{{3.540463718267501*^9, 3.540463791402684*^9}, {
  3.540463841915573*^9, 3.540463843456661*^9}, {3.5404638897013063`*^9, 
  3.540463901226966*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox["x", "2"], "+", "1"}], ",", " ", 
     FractionBox[
      RowBox[{
       SuperscriptBox["\[ExponentialE]", "x"], "+", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", "x"}]]}], "2"]}], "}"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", 
     RowBox[{"-", "3"}], ",", " ", "3"}], "}"}], ",", " ", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Hue", "[", "0", "]"}], ",", " ", 
      RowBox[{"Hue", "[", ".6", "]"}]}], "}"}]}]}], "]"}]], "Input"],

