           RowBox[{"a", "+", "b"}], "2"], ",", " ", 
          RowBox[{"f", "[", 
           FractionBox[
            RowBox[{"a", "+", "b"}], "2"], "]"}]}], "}"}]}], "}"}], 
      "\[IndentingNewLine]", ",", " ", "x"}], "]"}], "\[IndentingNewLine]", 
