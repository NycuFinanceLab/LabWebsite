Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Graphics", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Which", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "1"}], "&&", 
             RowBox[{"j", "\[Equal]", "1"}]}], ")"}], "||", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "1"}], "&&", 
             RowBox[{"j", "\[Equal]", "3"}]}], ")"}], "||", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "3"}], "&&", 
             RowBox[{"j", "\[Equal]", "1"}]}], ")"}], "||", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "3"}], "&&", 
             RowBox[{"j", "\[Equal]", "3"}]}], ")"}]}], " ", ",", " ", "Red", 
          ",", " ", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "1"}], "&&", 
             RowBox[{"j", "\[Equal]", "2"}]}], ")"}], "||", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "2"}], "&&", 
             RowBox[{"j", "\[Equal]", "1"}]}], ")"}], "||", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "3"}], "&&", 
             RowBox[{"j", "\[Equal]", "2"}]}], ")"}], "||", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"i", "\[Equal]", "2"}], "&&", 
             RowBox[{"j", "\[Equal]", "3"}]}], ")"}]}], " ", ",", " ", "Blue",
           ",", " ", "\[IndentingNewLine]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"i", "\[Equal]", "2"}], "&&", 
            RowBox[{"j", "\[Equal]", "2"}]}], ")"}], " ", ",", " ", 
          "Yellow"}], "\[IndentingNewLine]", "]"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"Rectangle", "[", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"j", ",", " ", "3"}], "}"}]}], "]"}], "\[IndentingNewLine]", 
    ",", " ", 
    RowBox[{"ImageSize", "\[Rule]", "Small"}]}], "]"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.5241037310823636`*^9, 3.5241038953435035`*^9}, {
   3.5241044906934466`*^9, 3.5241045154662905`*^9}, 3.524106633158907*^9, 
   3.5241067904383836`*^9}],

Cell[BoxData[
 GraphicsBox[{{
    {RGBColor[1, 0, 0], RectangleBox[{1, 1}]}, 
    {RGBColor[0, 0, 1], RectangleBox[{1, 2}]}, 
    {RGBColor[1, 0, 0], RectangleBox[{1, 3}]}}, {
    {RGBColor[0, 0, 1], RectangleBox[{2, 1}]}, 
    {RGBColor[1, 1, 0], RectangleBox[{2, 2}]}, 
    {RGBColor[0, 0, 1], RectangleBox[{2, 3}]}}, {
    {RGBColor[1, 0, 0], RectangleBox[{3, 1}]}, 
    {RGBColor[0, 0, 1], RectangleBox[{3, 2}]}, 
    {RGBColor[1, 0, 0], RectangleBox[{3, 3}]}}},
  ImageSize->Small]], "Output",
