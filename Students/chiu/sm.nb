 RowBox[{
  RowBox[{"Integrate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"InterpolatingPolynomial", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", ",", " ", 
          RowBox[{"f", "[", "a", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"b", ",", " ", 
          RowBox[{"f", "[", "b", "]"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
