Cell[CellGroupData[{

Cell["Find The Root In Head", "Section",
 CellChangeTimes->{{3.535690144819698*^9, 3.535690154527253*^9}, {
  3.5356902003418736`*^9, 3.535690207898306*^9}, {3.540461742807511*^9, 
  3.540461743997579*^9}, {3.5404617746143303`*^9, 3.5404617872810545`*^9}}],

Cell[TextData[{
 "This simple program helps to play the trick \[OpenCurlyDoubleQuote]find the \
root in head.\[CloseCurlyDoubleQuote]\nThis can be done when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "<", "1000"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " with exponent 2, \nor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "<", "100"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " with exponent 3, \nor ",
 Cell[BoxData[
  FormBox[
   RowBox[{"a", "<", "100"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " with exponent 41. "
}], "Text",
 CellChangeTimes->{{3.5404617893241715`*^9, 3.5404618587411423`*^9}, {
  3.540461898989444*^9, 3.540461901418583*^9}, {3.540462655218698*^9, 
  3.540462721410484*^9}, {3.5404627608367386`*^9, 3.540462824564384*^9}, {
  3.5404628546281033`*^9, 3.540462856226195*^9}, {3.54046307328961*^9, 
  3.5404630786929193`*^9}}],

