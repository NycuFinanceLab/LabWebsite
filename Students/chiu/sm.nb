        RowBox[{"Rectangle", "[", 
         RowBox[{"{", 
          RowBox[{"i", ",", " ", "j"}], "}"}], "]"}]}], "}"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", " ", "3"}], "}"}], ",", " ", 
