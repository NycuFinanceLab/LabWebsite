  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d1", "=", 
   FractionBox[
    RowBox[{
     RowBox[{"Log", "[", 
      FractionBox["s0", "K"], "]"}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", 
        FractionBox[
         SuperscriptBox["\[Sigma]", "2"], "2"]}], ")"}], "T"}]}], 
