     RowBox[{"K", ">", "0"}], "&&", 
     RowBox[{"\[Mu]", ">", "0"}], "&&", 
     RowBox[{"\[Sigma]", ">", "0"}]}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"Integrate", "[", 
