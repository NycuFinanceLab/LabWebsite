       RowBox[{"2", "\[Pi]"}]]}]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], 
      SuperscriptBox[
       RowBox[{"(", 
        FractionBox[
         RowBox[{
          RowBox[{"Log", "[", "x", "]"}], "-", "\[Mu]"}], "\[Sigma]"], ")"}], 
