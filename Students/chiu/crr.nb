Cell[TextData[{
 "Whenever the binomial distribution converges to the right normal \
distribution as ",
 Cell[BoxData[
  FormBox[
   RowBox[{"n", "\[Rule]", "\[Infinity]"}], TraditionalForm]]],
 " , the pricing result is correct. \nHere \[OpenCurlyDoubleQuote]the right \
normal distribution\[CloseCurlyDoubleQuote] means its first and second \
moments are correct. \nThere are various kinds of choices. "
}], "Text",
 CellChangeTimes->{{3.540554250966675*^9, 3.540554251437702*^9}, {
  3.540554298156374*^9, 3.540554425611664*^9}, {3.540554499133869*^9, 
  3.5405545301656446`*^9}}],

