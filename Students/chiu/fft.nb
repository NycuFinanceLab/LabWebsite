Cell[CellGroupData[{

Cell["\<\
The Plots of Probability Density Functions\
\>", "Section",
 CellChangeTimes->{{3.5404385279846992`*^9, 3.54043853604216*^9}, {
  3.5404596604754086`*^9, 3.5404596767883415`*^9}}],

Cell["\<\
In many option pricing models, only the characteristic function of the return \
of underlying asset are known analytically. 
In this case, to plot its probability density function, numerical methods can \
be used. 
By definition, the probability density function of a random variable is the \
inverse Fourier transform of its characteristic function, 
so the FFT algorithm can help to plot the density. 
Below the plots of density functions of five different models are given. 
The red line, the orange line, the green line, the blue line and the purple \
line are the density functions of Black-Scholes model, NIG model, CGMY model, \
Merton\[CloseCurlyQuote]s jump diffusion model, and double exponential model, \
respectively. \
\>", "Text",
 CellChangeTimes->{{3.540459678919463*^9, 3.540459690626133*^9}, {
  3.5404597395949335`*^9, 3.540459776996073*^9}, {3.5404598112890344`*^9, 
  3.540460294578677*^9}, {3.5404603988056383`*^9, 3.540460411124343*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "\[Alpha]", ",", " ", "s", ",", " ", "\[Beta]", ",", " ", "\[Delta]", ",",
      " ", "c", ",", " ", "G", ",", " ", "M", ",", " ", "Y", ",", " ", 
     "\[Lambda]", ",", " ", "r", ",", " ", "dt", ",", " ", "u", ",", " ", "p",
      ",", " ", "\[Eta]"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", "1000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"-", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "2"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"h", "=", 
   FractionBox[
    RowBox[{"b", "-", "a"}], "m"]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xaxis", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"a", ",", " ", "b", ",", " ", "h"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dt", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Adjustchf", "[", 
    RowBox[{"chf_", ",", " ", "r_", ",", " ", "u_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{"chf", "[", "u", "]"}], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"\[ImaginaryI]", 
      RowBox[{"(", 
       RowBox[{"r", "-", 
        FractionBox[
         RowBox[{"Log", "[", 
          RowBox[{"chf", "[", 
           RowBox[{"-", "\[ImaginaryI]"}], "]"}], "]"}], "dt"]}], ")"}], "dt",
       " ", "u"}]]}]}], ";", 
  RowBox[{"(*", " ", 
   RowBox[{"in", " ", "risk", " ", "neutral", " ", "world"}], " ", "*)"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"parag", "=", 
   RowBox[{"{", 
    RowBox[{"s", "\[Rule]", "0.17801"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"paranig", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "\[Rule]", "6.1882"}], ",", 
     RowBox[{"\[Beta]", "\[Rule]", 
      RowBox[{"-", "3.8941"}]}], ",", 
     RowBox[{"\[Delta]", "\[Rule]", "0.1622"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"paracgmy", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"c", "\[Rule]", "0.0244"}], ",", " ", 
     RowBox[{"G", "\[Rule]", "0.0765"}], ",", " ", 
     RowBox[{"M", "\[Rule]", "7.5515"}], ",", " ", 
     RowBox[{"Y", "\[Rule]", "1.2945"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"parajd", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "\[Rule]", 
      RowBox[{"-", "0.390078"}]}], ",", " ", 
     RowBox[{"\[Lambda]", "\[Rule]", "0.174814"}], ",", " ", 
     RowBox[{"\[Delta]", "\[Rule]", "0.338796"}], ",", " ", 
     RowBox[{"s", "\[Rule]", "0.126349"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"parade", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"p", "\[Rule]", "0.2071"}], ",", " ", 
      RowBox[{"\[Lambda]", "\[Rule]", "0.330966"}], ",", " ", 
      RowBox[{"c", "\[Rule]", "3.13868"}], ",", " ", 
      RowBox[{"\[Eta]", "\[Rule]", "9.65997"}], ",", " ", 
      RowBox[{"s", "\[Rule]", "0.120381"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"r", "=", "0.0367"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chfg", "[", "u_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         SuperscriptBox["s", "2"], "dt"}], "2"]}], 
      SuperscriptBox["u", "2"]}]], "/.", "parag"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chfnig", "[", "u_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", "\[Delta]"}], " ", "dt", " ", 
      RowBox[{"(", 
       RowBox[{
        SqrtBox[
         RowBox[{
          SuperscriptBox["\[Alpha]", "2"], "-", 
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"\[Beta]", "+", 
             RowBox[{"\[ImaginaryI]", " ", "u"}]}], ")"}], "2"]}]], "-", 
        SqrtBox[
         RowBox[{
          SuperscriptBox["\[Alpha]", "2"], "-", 
          SuperscriptBox["\[Beta]", "2"]}]]}], ")"}]}]], "/.", "paranig"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chfcgmy", "[", "u_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"c", " ", 
      RowBox[{"Gamma", "[", 
       RowBox[{"-", "Y"}], "]"}], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"M", "-", 
           RowBox[{"\[ImaginaryI]", " ", "u"}]}], ")"}], "Y"], "-", 
        SuperscriptBox["M", "Y"], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"G", "+", 
           RowBox[{"\[ImaginaryI]", " ", "u"}]}], ")"}], "Y"], "-", 
        SuperscriptBox["G", "Y"]}], ")"}], "dt"}]], "/.", "paracgmy"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chfjd", "[", "u_", "]"}], ":=", 
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          SuperscriptBox["s", "2"], "dt"}], "2"]}], 
       SuperscriptBox["u", "2"]}], "+", 
      RowBox[{"\[Lambda]", " ", "dt", " ", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"\[ImaginaryI]", " ", "u", " ", "\[Alpha]"}], "-", 
           RowBox[{
            FractionBox["1", "2"], 
            SuperscriptBox["u", "2"], 
            SuperscriptBox["\[Delta]", "2"]}]}]], "-", "1"}], ")"}]}]}]], "/.",
     "parajd"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"chfde", "[", "u_", "]"}], ":=", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           SuperscriptBox["s", "2"], " ", "dt"}], "2"]}], 
        SuperscriptBox["u", "2"]}], "+", " ", 
       RowBox[{"\[Lambda]", " ", "dt", 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "p"}], ")"}], "c"}], 
           RowBox[{"c", " ", "+", 
            RowBox[{"\[ImaginaryI]", " ", "u"}]}]], "+", 
          FractionBox[
           RowBox[{"p", " ", "\[Eta]"}], 
           RowBox[{"\[Eta]", " ", "+", " ", 
            RowBox[{"\[ImaginaryI]", " ", "u"}]}]], "-", "1"}], ")"}]}]}]], "/.",
      "parade"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", 
