Cell[CellGroupData[{

Cell["Demonstrate How FFT Works In Matrix Form", "Section",
 CellChangeTimes->{{3.540026516955016*^9, 3.540026554633171*^9}, 
   3.5404376882296677`*^9, {3.5404427889154105`*^9, 3.540442796799861*^9}, {
   3.540444379407381*^9, 3.5404443852037125`*^9}}],

Cell[TextData[{
 "The discrete Fourier transform of a vector ",
 Cell[BoxData[
  FormBox["v", TraditionalForm]]],
 " is equivalent to ",
 Cell[BoxData[
  FormBox[
   RowBox[{Cell[""], 
    FractionBox["1", 
     SqrtBox["n"]], "F", " ", "v", " "}], TraditionalForm]]],
 ", where ",
 Cell[BoxData[
  FormBox["F", TraditionalForm]]],
 " is the matrix defined as follows:"
}], "Text",
 CellChangeTimes->{{3.540439524435693*^9, 3.540439528130904*^9}, {
  3.5404395613208027`*^9, 3.5404395970498457`*^9}, {3.540439637099137*^9, 
  3.5404396825837383`*^9}, {3.5404397326576023`*^9, 3.5404397597021494`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  StyleBox[
   RowBox[{"(*", " ", 
    RowBox[{"DFT", " ", "matrix"}], " ", "*)"}],
   FontColor->RGBColor[1, 0, 1]], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"n", "=", "8"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"F", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"\[ImaginaryI]", " ", 
         FractionBox[
          RowBox[{"2", "\[Pi]", " ", "i", " ", "j"}], "n"]}]], ",", " ", 
       RowBox[{"{", 
        RowBox[{"i", ",", " ", "0", ",", " ", 
         RowBox[{"n", "-", "1"}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"j", ",", " ", "0", ",", " ", 
         RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"F", "//", "MatrixForm"}]}]}]], "Input",
 CellChangeTimes->{{3.5403448549749093`*^9, 3.5403448950131993`*^9}, {
  3.5404395125860147`*^9, 3.54043951372208*^9}}],

