Carr & Madan\[CloseCurlyQuote]s Option Pricing Algorithm\
\>", "Section",
 CellChangeTimes->{{3.5405493089670086`*^9, 3.540549342217911*^9}}],

Cell["\<\
Here option values under variance-gamma model is evaluated with Carr & Madan\
\[CloseCurlyQuote]s option pricing algorithm. 
The output list gives the number of grid points, grid width, running time, \
and option value, respectively. \
\>", "Text",
 CellChangeTimes->{{3.5405496049919405`*^9, 3.540549667659525*^9}, {
  3.5405497843401985`*^9, 3.5405499093283477`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"CM", "[", 
     RowBox[{
     "s0_", ",", "K_", ",", "r_", ",", "T_", ",", "\[Alpha]_", ",", "\[Eta]_",
       ",", "n_", ",", "chf_"}], "]"}], ":=", "\[IndentingNewLine]", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "aa", ",", "\[CapitalLambda]", ",", "bb", ",", "v", ",", "w", ",", 
        "ku", ",", "call"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"CPUTime", "=", 
        RowBox[{"TimeUsed", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[CapitalPhi]", "[", "u_", "]"}], ":=", 
        RowBox[{"Log", "[", 
         RowBox[{"chf", "[", 
          RowBox[{"u", ",", "T"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Phi]", "[", "u_", "]"}], ":=", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "u", " ", 
           RowBox[{"Log", "[", "s0", "]"}]}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"\[ImaginaryI]", " ", "u", " ", 
           RowBox[{"(", 
            RowBox[{"r", "-", 
             FractionBox[
              RowBox[{"\[CapitalPhi]", "[", 
               RowBox[{"-", "\[ImaginaryI]"}], "]"}], "T"]}], ")"}], "T"}]], 
         RowBox[{"chf", "[", 
          RowBox[{"u", ",", "T"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Psi]", "[", "u_", "]"}], ":=", 
        FractionBox[
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "r"}], " ", "T"}]], 
          RowBox[{"\[Phi]", "[", 
           RowBox[{"(", 
            RowBox[{"u", "-", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"\[Alpha]", "+", "1"}], ")"}], "\[ImaginaryI]"}]}], 
            ")"}], "]"}]}], 
         RowBox[{
          SuperscriptBox["\[Alpha]", "2"], "+", "\[Alpha]", "-", 
          SuperscriptBox["u", "2"], "+", 
          RowBox[{"\[ImaginaryI]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"2", "\[Alpha]"}], "+", "1"}], ")"}], "u"}]}]]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"aa", "=", 
        RowBox[{"n", " ", "\[Eta]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"\[CapitalLambda]", "=", 
        FractionBox[
         RowBox[{"2", " ", "\[Pi]"}], 
         RowBox[{"n", " ", "\[Eta]"}]]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bb", "=", 
        RowBox[{
         FractionBox[
          RowBox[{"n", " ", "\[CapitalLambda]"}], "2"], "-", 
         RowBox[{"Log", "[", "K", "]"}]}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"v", "=", 
        RowBox[{"Delete", "[", 
         RowBox[{
          RowBox[{"Range", "[", 
           RowBox[{"0", ",", "aa", ",", "\[Eta]"}], "]"}], ",", 
          RowBox[{"-", "1"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"w", "=", 
        RowBox[{
         FractionBox["1", "3"], 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"3", "+", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"-", "1"}], ")"}], "j"], "-", 
            RowBox[{"KroneckerDelta", "[", 
             RowBox[{"j", "-", "1"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"ku", "=", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "bb"}], "+", 
           RowBox[{"\[CapitalLambda]", 
            RowBox[{"(", 
             RowBox[{"i", "-", "1"}], ")"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"call", "=", 
        RowBox[{
         FractionBox[
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[Alpha]"}], " ", "ku"}]], "\[Pi]"], " ", 
         RowBox[{"InverseFourier", "[", 
          RowBox[{
           RowBox[{"w", " ", 
            RowBox[{"Re", "[", 
             RowBox[{
              SuperscriptBox["\[ExponentialE]", 
               RowBox[{"\[ImaginaryI]", " ", "bb", " ", "v"}]], 
              RowBox[{"\[Psi]", "[", "v", "]"}], "\[Eta]"}], "]"}]}], ",", 
           RowBox[{"FourierParameters", "\[Rule]", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"-", "1"}], ",", "1"}], "}"}]}]}], "]"}]}]}], " ", ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"aa", ",", "\[Eta]", ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"TimeUsed", "[", "]"}], "-", "CPUTime"}], ")"}], ",", 
          RowBox[{"Re", "[", 
           RowBox[{"call", "[", 
            RowBox[{"[", 
             RowBox[{
              FractionBox["n", "2"], "+", "1"}], "]"}], "]"}], "]"}]}], "}"}],
         "//", "Return"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"chfvg", ",", "\[Theta]", ",", "\[Nu]", ",", "\[Sigma]"}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"para", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Theta]", "\[Rule]", " ", 
      RowBox[{"-", "0.1"}]}], ",", 
     RowBox[{"\[Nu]", "\[Rule]", "2"}], " ", ",", 
     RowBox[{"\[Sigma]", "\[Rule]", " ", "0.25"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"chfvg", "[", 
    RowBox[{"u_", ",", "T_"}], "]"}], ":=", 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"\[ImaginaryI]", " ", "\[Theta]", " ", "\[Nu]", " ", "u"}], 
       "+", 
       RowBox[{
        FractionBox["1", "2"], 
        SuperscriptBox["\[Sigma]", "2"], 
        SuperscriptBox["u", "2"], "\[Nu]"}]}], ")"}], 
     RowBox[{"-", 
      FractionBox["T", "\[Nu]"]}]], "/.", "para"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"CM", "[", 
  RowBox[{
  "100", ",", "77", ",", "0.02", ",", "0.25", ",", "1.5", ",", ".25", ",", 
   SuperscriptBox["2", "11"], ",", "chfvg"}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
