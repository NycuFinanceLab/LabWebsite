Cell["FRFT", "Section",
 CellChangeTimes->{{3.5400843451866016`*^9, 3.5400843474347305`*^9}, {
  3.540085056055261*^9, 3.540085056694298*^9}}],

Cell[TextData[{
 "The discrete Fourier transform evaluate ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["r", "TI"], "=", 
     StyleBox["1", "TR"]}], 
    StyleBox["n", "TI"],
    LimitsPositioning->True], 
   RowBox[{
    SubscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["r", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["2", "TR"], 
      StyleBox["\[Pi]", "TR"], 
      StyleBox[" ", "TR"], 
      StyleBox["i", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["r", "TI"], "-", 
        StyleBox["1", "TR"]}], ")"}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         StyleBox["s", "TI"], "-", 
         StyleBox["1", "TR"]}], ")"}], "/", 
       StyleBox["n", "TI"]}]}]]}]}]], "InlineFormula"],
 ". \nIn some cases we need the fractional Fourier transform (FrFT) ",
 Cell[BoxData[
  RowBox[{
   UnderoverscriptBox["\[Sum]", 
    RowBox[{
     StyleBox["r", "TI"], "=", 
     StyleBox["1", "TR"]}], 
    StyleBox["n", "TI"],
    LimitsPositioning->True], 
   RowBox[{
    SubscriptBox[
     StyleBox["u", "TI"], 
     StyleBox["r", "TI"]], 
    SuperscriptBox[
     StyleBox["e", "TI"], 
     RowBox[{
      StyleBox["2", "TR"], 
      StyleBox["\[Pi]", "TR"], 
      StyleBox[" ", "TR"], 
      StyleBox["i", "TI"], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["r", "TI"], "-", 
        StyleBox["1", "TR"]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        StyleBox["s", "TI"], "-", 
        StyleBox["1", "TR"]}], ")"}], "\[Alpha]"}]]}]}]], "InlineFormula"],
 ". \nThis can also be done in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", 
    RowBox[{"(", 
     RowBox[{"n", " ", "log", " ", "n"}], ")"}]}], TraditionalForm]]],
 " computations. \nThe following algorithm is given by David H. Bailey & Paul \
N. Swarztrauber. \nAgain, the built-in function Fourier[] which can do this. \
\nI just write this to serve as a pseudo code so that i can impliment it in \
C. \nNote that the inverse FrFT is unnecessary since ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]]],
 " can be negative."
}], "Text",
 CellChangeTimes->{{3.540438924495378*^9, 3.5404390387749147`*^9}, {
  3.540439074285946*^9, 3.5404391145752497`*^9}, {3.540440717524934*^9, 
  3.540440741917329*^9}, {3.540440821186863*^9, 3.540440991030577*^9}, {
  3.540441135272827*^9, 3.540441282730262*^9}, {3.5404524018142366`*^9, 
  3.5404524095876813`*^9}, {3.54045278808033*^9, 3.540452808097475*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FrFT", "[", 
     RowBox[{"aaa_", ",", " ", "\[Alpha]_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"y", ",", " ", "z", ",", " ", "n"}], "}"}], ",", 
      RowBox[{"(*", " ", 
       RowBox[{"output", " ", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
            "2", " ", "\[Pi]", " ", "\[ImaginaryI]", " ", "j", " ", "k", " ", 
             "\[Alpha]"}]], ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", ",", "0", ",", " ", 
             RowBox[{"n", "-", "1"}]}], "}"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"j", ",", " ", "0", ",", " ", 
             RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ".", "aaa"}]}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "aaa", "]"}]}], ";", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"y", "=", 
        RowBox[{"PadRight", "[", 
         RowBox[{
          RowBox[{"aaa", " ", 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
             SuperscriptBox[
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", " ", 
                RowBox[{"n", "-", "1"}]}], "]"}], "2"], "\[Alpha]"}]]}], ",", 
          " ", 
          RowBox[{"2", "n"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"z", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Pi]", " ", 
            SuperscriptBox[
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{"n", "-", "1"}]}], "]"}], "2"], "\[Alpha]"}]], ",", 
          " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Pi]", " ", 
            SuperscriptBox[
             RowBox[{"Range", "[", 
              RowBox[{"n", ",", " ", "1", ",", " ", 
               RowBox[{"-", "1"}]}], "]"}], "2"], "\[Alpha]"}]]}], "]"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
            SuperscriptBox[
             RowBox[{"Range", "[", 
              RowBox[{"0", ",", " ", 
               RowBox[{"n", "-", "1"}]}], "]"}], "2"], "\[Alpha]"}]], " ", 
          RowBox[{"(", 
           RowBox[{
            SqrtBox[
             RowBox[{"2", "n"}]], 
            RowBox[{"Take", "[", 
             RowBox[{
              RowBox[{"InverseFourier", "[", 
               RowBox[{
                RowBox[{"Fourier", "[", "y", "]"}], " ", 
                RowBox[{"Fourier", "[", "z", "]"}]}], "]"}], ",", " ", "n"}], 
             "]"}]}], ")"}]}], "//", "Chop"}], "//", "Return"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"with", " ", "my", " ", "own", " ", 
     RowBox[{"FFT", "[", "]"}]}], ",", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
        "the", " ", "last", " ", "line", " ", "in", " ", "the", " ", 
         "function", " ", "should", " ", 
         RowBox[{"be", ":", "\[IndentingNewLine]", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Pi]", " ", 
             SuperscriptBox[
              RowBox[{"Range", "[", 
               RowBox[{"0", ",", " ", 
                RowBox[{"n", "-", "1"}]}], "]"}], "2"], "\[Alpha]"}]], " ", 
           RowBox[{"(", 
            RowBox[{
             FractionBox["1", 
              RowBox[{"2", "n"}]], 
             RowBox[{"Take", "[", 
              RowBox[{
               RowBox[{"IFFT", "[", 
                RowBox[{
                 RowBox[{"FFT", "[", "%%%", "]"}], " ", 
                 RowBox[{"FFT", "[", "%%", "]"}]}], "]"}], ",", " ", "n"}], 
              "]"}]}], ")"}]}]}]}], "//", "N"}], "//", "Chop"}], "//", 
      "Return"}], ";"}]}], "\[IndentingNewLine]", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "verify", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bbb", "=", 
   RowBox[{"{", 
    RowBox[{
    "2", ",", " ", "3", ",", " ", "5", ",", " ", "7", ",", " ", "11", ",", 
     " ", "13", ",", " ", "17", ",", " ", "19"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "bbb", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"a", "=", 
    SqrtBox["5"]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"my", " ", "function"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tt1", "=", 
    RowBox[{"FrFT", "[", 
     RowBox[{"bbb", ",", " ", "a"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"brute", " ", "force"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tt2", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
         "2", "\[Pi]", " ", "\[ImaginaryI]", " ", "j", " ", "k", " ", "a"}]], 
        ",", " ", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", " ", 
          RowBox[{"n", "-", "1"}]}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"j", ",", " ", "0", ",", " ", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}], ".", "bbb"}], "//", 
     "N"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", " ", 
   RowBox[{"built", "-", 
    RowBox[{"in", " ", "function"}]}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tt3", "=", 
    RowBox[{
     RowBox[{"Fourier", "[", 
      RowBox[{"bbb", ",", " ", 
       RowBox[{"FourierParameters", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"1", ",", " ", 
          RowBox[{"a", " ", "n"}]}], "}"}]}]}], "]"}], "//", "Chop"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{"tt1", ",", " ", "tt2", ",", " ", "tt3"}], "}"}], "}"}], "//", 
  "TableForm"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tt1", "-", "tt2"}], "//", "Chop"}]}], "Input",
 CellChangeTimes->{{3.5403438048768473`*^9, 3.540344231244234*^9}, {
