Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "the", " ", "two", " ", "functions", " ", "to", " ", "be", " ", 
    "convolved"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"f", "[", "x_", "]"}], ":=", 
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        RowBox[{"2", "\[Pi]"}]]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox["x", "2"], "2"]}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"g", "[", "x_", "]"}], ":=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"0.4", 
        SqrtBox[
         RowBox[{"2", "\[Pi]"}]]}]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           FractionBox["x", "0.4"], ")"}], "2"], "2"]}]]}]}], ";"}], 
   "\[IndentingNewLine]", "Export", "\[IndentingNewLine]", 
   RowBox[{"Animate", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"g", "[", "x", "]"}], ",", " ", 
         RowBox[{"f", "[", 
          RowBox[{"a", "-", "x"}], "]"}], ",", " ", 
         RowBox[{
          RowBox[{"g", "[", "x", "]"}], 
          RowBox[{"f", "[", 
           RowBox[{"a", "-", "x"}], "]"}]}], ",", " ", 
         RowBox[{"10", 
          RowBox[{"Boole", "[", 
           RowBox[{"x", ">", "a"}], "]"}]}]}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", " ", 
         RowBox[{"-", "5"}], ",", " ", "5"}], "}"}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotRange", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"0", ",", " ", "1.2"}], "}"}]}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"PlotStyle", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Hue", "[", "0", "]"}], ",", " ", 
          RowBox[{"Hue", "[", ".6", "]"}], ",", " ", 
          RowBox[{"Hue", "[", ".3", "]"}], ",", " ", 
          RowBox[{"Hue", "[", ".3", "]"}]}], "}"}]}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"Filling", "\[Rule]", 
        RowBox[{"{", 
         RowBox[{"3", "\[Rule]", "Bottom"}], "}"}]}], ",", " ", 
       "\[IndentingNewLine]", 
       RowBox[{"ImageSize", "\[Rule]", "400"}]}], "]"}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", 
       RowBox[{"-", "5"}], ",", "5"}], "}"}], ",", 
     RowBox[{"AnimationRunning", "\[Rule]", "False"}]}], "]"}]}]}]], "Input",
