Cell[TextData[{
 Cell[BoxData[
  FormBox["F", TraditionalForm]]],
 " can be decomposed into ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"log", " ", "n"}], "+", "1"}], TraditionalForm]]],
 " sparse matrics. \[LineSeparator]That\[CloseCurlyQuote]s why FFT can be \
done in ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", 
    RowBox[{"(", 
     RowBox[{"n", " ", "log", " ", "n"}], ")"}]}], TraditionalForm]]],
 " computational time. "
}], "Text",
 CellChangeTimes->{{3.5404403651937814`*^9, 3.54044037741148*^9}, {
   3.540440433309677*^9, 3.5404405015345793`*^9}, 3.5404409617329016`*^9}],

