Cell[CellGroupData[{

Cell["FFT -- Cooley\[Dash]Tukey Algorithm ", "Section",
 CellChangeTimes->{{3.540084320397184*^9, 3.5400843300097337`*^9}, 
   3.540438820025403*^9, {3.5404389152168474`*^9, 3.5404389227362776`*^9}, {
   3.5404391246598268`*^9, 3.5404391269459577`*^9}, 3.540442800910096*^9}],

Cell["\<\
There is built-in function Fourier[] which can evaluate the fast Fourier \
trnasform of a list. 
Here I write this to serve as a pseudo code so that i can impliment it in C. \
\>", "Text",
 CellChangeTimes->{{3.540438924495378*^9, 3.5404390387749147`*^9}, {
  3.540439074285946*^9, 3.5404391145752497`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FFT", "[", "aaa_", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "bbb", ",", " ", "even", ",", " ", "odd"}], 
       "}"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "the", " ", "length", " ", "of", " ", "the", " ", "input", " ", "must",
         " ", "be", " ", "a", " ", "power", " ", "of", " ", "2"}], " ", 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bbb", "=", "aaa"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "bbb", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"n", "\[Equal]", "1"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "bbb", "]"}], ",", " ", "\[IndentingNewLine]",
          "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"n", "\[NotEqual]", "1"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"even", "=", 
           RowBox[{"FFT", "[", 
            RowBox[{"bbb", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"2", 
                RowBox[{"Range", "[", 
                 RowBox[{"n", "/", "2"}], "]"}]}], "-", "1"}], "]"}], "]"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"odd", "=", 
           RowBox[{
            RowBox[{"FFT", "[", 
             RowBox[{"bbb", "[", 
              RowBox[{"[", 
               RowBox[{"2", 
                RowBox[{"Range", "[", 
                 RowBox[{"n", "/", "2"}], "]"}]}], "]"}], "]"}], "]"}], 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{"2", "\[Pi]", " ", "\[ImaginaryI]", " ", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", " ", 
                 RowBox[{
                  RowBox[{"n", "/", "2"}], "-", "1"}]}], "]"}], "/", 
               "n"}]}]]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"even", "+", "odd"}], ",", " ", 
             RowBox[{"even", "-", "odd"}]}], "]"}], "//", "Return"}], ";"}]}],
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"IFFT", "[", "aaa_", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"n", ",", " ", "bbb", ",", " ", "even", ",", " ", "odd"}], 
       "}"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
       "the", " ", "length", " ", "of", " ", "the", " ", "input", " ", "must",
         " ", "be", " ", 
        SuperscriptBox["2", "k"]}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"bbb", "=", "aaa"}], ";", "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "bbb", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"n", "\[Equal]", "1"}], ",", "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"n", "\[Equal]", "1"}], " ", "*)"}], "\[IndentingNewLine]", 
         RowBox[{"Return", "[", "bbb", "]"}], ",", " ", "\[IndentingNewLine]",
          "\[IndentingNewLine]", 
         RowBox[{"(*", " ", 
          RowBox[{"n", "\[NotEqual]", "1"}], " ", "*)"}], 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"even", "=", 
           RowBox[{"IFFT", "[", 
            RowBox[{"bbb", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"2", 
                RowBox[{"Range", "[", 
                 RowBox[{"n", "/", "2"}], "]"}]}], "-", "1"}], "]"}], "]"}], 
            "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"odd", "=", 
           RowBox[{
            RowBox[{"IFFT", "[", 
             RowBox[{"bbb", "[", 
              RowBox[{"[", 
               RowBox[{"2", 
                RowBox[{"Range", "[", 
                 RowBox[{"n", "/", "2"}], "]"}]}], "]"}], "]"}], "]"}], 
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "2"}], "\[Pi]", " ", "\[ImaginaryI]", " ", 
              RowBox[{
               RowBox[{"Range", "[", 
                RowBox[{"0", ",", " ", 
                 RowBox[{
                  RowBox[{"n", "/", "2"}], "-", "1"}]}], "]"}], "/", 
               "n"}]}]]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Join", "[", 
            RowBox[{
             RowBox[{"even", "+", "odd"}], ",", " ", 
             RowBox[{"even", "-", "odd"}]}], "]"}], "//", "Return"}], ";"}]}],
         "\[IndentingNewLine]", "]"}], ";"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", "verify", " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bbb", "=", 
   RowBox[{"{", 
    RowBox[{
    "2", ",", " ", "3", ",", " ", "5", ",", " ", "7", ",", " ", "11", ",", 
     " ", "13", ",", " ", "17", ",", " ", "19"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"FFT", "[", "bbb", "]"}], "//", "N"}], ")"}], "-", 
   RowBox[{
    RowBox[{"Fourier", "[", "bbb", "]"}], 
    SqrtBox["8"]}]}], "//", "Chop"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"IFFT", "[", "bbb", "]"}], "//", "N"}], ")"}], "-", 
