Cell[CellGroupData[{

Cell["Box-Muller", "Subsection",
 CellChangeTimes->{{3.512091524441493*^9, 3.5120915273430977`*^9}, {
  3.540517835734843*^9, 3.540517835965856*^9}}],

Cell[TextData[{
 "According to the Box-Muller algorithm, the random variable ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{
      RowBox[{"-", "2"}], "log", " ", 
      SubscriptBox["U", "1"]}]], 
    RowBox[{"cos", "(", 
     RowBox[{"2", "\[Pi]", " ", 
      SubscriptBox["U", "2"]}], ")"}]}], TraditionalForm]]],
 " are normally distributed, where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["U", "1"], ",", " ", 
    SubscriptBox["U", "2"]}], TraditionalForm]]],
 " are uniform random variable. \nBut ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " fails to work out the distribution of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SqrtBox[
     RowBox[{
      RowBox[{"-", "2"}], "log", " ", 
      SubscriptBox["U", "1"]}]], 
    RowBox[{"cos", "(", 
     RowBox[{"2", "\[Pi]", " ", 
      SubscriptBox["U", "2"]}], ")"}]}], TraditionalForm]]],
 ". "
}], "Text",
 CellChangeTimes->{{3.5110503559241686`*^9, 3.51105036817019*^9}, {
  3.540517811161437*^9, 3.540518029786942*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"bb", "=", 
   RowBox[{"TransformedDistribution", "[", 
    RowBox[{
     RowBox[{
      SqrtBox[
       RowBox[{
        RowBox[{"-", "2"}], 
        RowBox[{"Log", "[", "a1", "]"}]}]], 
      RowBox[{"Cos", "[", 
       RowBox[{"2", "\[Pi]", " ", "a2"}], "]"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"a1", "\[Distributed]", "\[ScriptCapitalU]"}], ",", " ", 
       RowBox[{"a2", "\[Distributed]", "\[ScriptCapitalU]"}]}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"h", "[", "x_", "]"}], ":=", 
   RowBox[{"PDF", "[", 
    RowBox[{"bb", ",", " ", "x"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"h", "[", "x", "]"}]}], "Input",
 CellChangeTimes->{{3.511050121502557*^9, 3.5110501680686383`*^9}, {
  3.511050198597892*^9, 3.5110502187999277`*^9}, {3.511050280076835*^9, 
  3.5110502958952627`*^9}, {3.511050345986951*^9, 3.5110503473597536`*^9}, {
  3.5110585581094627`*^9, 3.511058564220812*^9}, {3.5110655678550572`*^9, 
  3.5110655805690794`*^9}}],

Cell[BoxData["$Aborted"], "Output",
 CellChangeTimes->{3.5110503524609623`*^9, 3.5110602003329983`*^9}]
}, Open  ]]
}, Closed]]
}, Closed]],

Cell[CellGroupData[{

Cell["Modified Box-Muller Algorithm", "Section"],

Cell[CellGroupData[{

Cell["The Idea", "Subsection",
 CellChangeTimes->{{3.5405124464025908`*^9, 3.540512449418763*^9}}],

Cell["11/25/2010", "Text"],

Cell[TextData[{
 "In the Box-Muller algorithm, two uniform random variables are first \
generated to obtain two iid standard normal random variables. \nThe two \
uniform variables should satisfy some specific condition,\nor otherwise they \
will be thrown away and another two uniform variables are generated. \nWhen \
every two uniform variables are generated, they have ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"1", "-", 
     RowBox[{"\[Pi]", "/", "4"}]}], "=", 
    RowBox[{"21.46", "%"}]}], TraditionalForm]]],
 " chance of being thrown away. \nHere some of the uniform variables that are \
thrown away are kept and used to generate normal random variables, \nin order \
to make the Box-Muller Algorithm more efficient. "
}], "Text",
 CellChangeTimes->{{3.54051268749138*^9, 3.5405127822207985`*^9}, {
  3.5405128239371843`*^9, 3.5405129542766395`*^9}, {3.540513007644692*^9, 
  3.5405130666660676`*^9}, {3.5405131501688437`*^9, 3.540513220054841*^9}, {
  3.540513394409814*^9, 3.5405134303488693`*^9}, {3.540513491348358*^9, 
  3.5405135393201017`*^9}, {3.54051490719634*^9, 3.5405149090664473`*^9}, {
  3.5405156722681*^9, 3.5405157199648275`*^9}, {3.5405157580400057`*^9, 
  3.5405157843555107`*^9}, {3.5405159189172072`*^9, 3.5405159355921607`*^9}, {
  3.540515970217141*^9, 3.540515996891667*^9}, {3.540516211383935*^9, 
  3.5405162148541336`*^9}, {3.5405162488930807`*^9, 3.540516284506118*^9}}],

