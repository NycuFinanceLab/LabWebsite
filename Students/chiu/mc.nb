    {"\[Piecewise]", GridBox[{
       {"0", 
        RowBox[{"x", "<", "0"}]},
       {
        FractionBox[
         SuperscriptBox["x", "2"], "2"], 
        RowBox[{"0", "\[LessEqual]", "x", "<", "1"}]},
       {
