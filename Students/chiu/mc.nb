Cell[CellGroupData[{

Cell["The Sum of 12 Uniform Random Variables", "Section",
 CellChangeTimes->{{3.5120914115752945`*^9, 3.5120914432901506`*^9}, {
  3.5405180468939204`*^9, 3.5405180748105173`*^9}}],

Cell["\<\
In Monte Carlo option pricing, one needs to generate standard normal random \
variables. 
Perhaps the simplest way to do this is to use the sum of 12 uniform variables. 
Here are the plots and the probability density functions of the sums of \
uniform random variables. \
\>", "Text",
 CellChangeTimes->{{3.54051807853273*^9, 3.5405181690989103`*^9}, {
  3.540518262268239*^9, 3.5405183492742157`*^9}, {3.540518536716937*^9, 
  3.540518649228372*^9}}],

