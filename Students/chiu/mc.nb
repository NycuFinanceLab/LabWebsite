Cell[CellGroupData[{

Cell["\<\
Monte Carlo Asian Option Pricing\
\>", "Section",
 CellChangeTimes->{{3.5133178719507236`*^9, 3.513317874852329*^9}, 
   3.540464364475462*^9, {3.540516727037429*^9, 3.5405167425823183`*^9}, {
   3.5405350371157055`*^9, 3.5405350374177227`*^9}}],

Cell["\<\
With control variates method, the sample variance is reduced significantly, \
and hence the prcing result is better. 
Note that the exact value under this numerical setting this \
2.3682854518288..., which is obtained by convolution pricing. 
It does take more time to evaluate the geometric mean of sample prices, but \
it\[CloseCurlyQuote]s worthy. \
\>", "Text",
 CellChangeTimes->{{3.54053502460299*^9, 3.540535040185881*^9}, {
  3.5405351219635587`*^9, 3.540535156113512*^9}, {3.540535308481227*^9, 
  3.5405353930460634`*^9}, {3.5405354493582845`*^9, 3.5405355179812098`*^9}}],

Cell[CellGroupData[{

Cell["\<\
Without Control Variates method\
\>", "Subsection",
 CellChangeTimes->{{3.5405333423327694`*^9, 3.540533344738907*^9}, {
  3.540534845625753*^9, 3.5405348495619783`*^9}, {3.540535114908155*^9, 
  3.54053511621023*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"T", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "50"}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"number", " ", "of", " ", "periods"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", "5000"}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"number", " ", "of", " ", "paths"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dt", "=", 
    FractionBox["T", "n"]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"s", "=", "0.3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"s0", "=", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"K", "=", "120"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmp", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fig", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"CPUtime", "=", 
   RowBox[{"TimeUsed", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "=", 
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", " ", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"aaa", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", " ", 
         RowBox[{
          RowBox[{"RandomReal", "[", 
           RowBox[{"z", ",", " ", "n"}], "]"}], "//", "Accumulate"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"aaa", "=", 
       RowBox[{"s0", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"r", "-", 
             FractionBox[
              SuperscriptBox["s", "2"], "2"]}], ")"}], 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", "T", ",", " ", "dt"}], "]"}]}], "+", 
          RowBox[{"s", 
           SqrtBox["dt"], " ", "aaa"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"tmp", ",", " ", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "r"}], " ", "T"}]], 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Mean", "[", "aaa", "]"}], "-", "K"}], ",", " ", "0"}], 
          "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "p"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"sample", " ", "mean", " ", 
     RowBox[{"(", 
      RowBox[{"option", " ", "price"}], ")"}]}], ",", " ", 
    RowBox[{"sample", " ", "sd"}], ",", " ", 
    RowBox[{"and", " ", "running", " ", "time"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmp", "//", "Mean"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmp", "//", "StandardDeviation"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TimeUsed", "[", "]"}], "-", "CPUtime"}], " ", 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
   "histogram", " ", "of", " ", "sample", " ", "prices", " ", "that", " ", 
    "are", " ", "not", " ", "zero"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"Histogram", "[", 
  RowBox[{
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"tmp", "//", "Chop"}], ",", " ", "0"}], "]"}], ",", " ", 
   RowBox[{"{", "1", "}"}]}], "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{
