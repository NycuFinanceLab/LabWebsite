Cell[CellGroupData[{

Cell["Normal Random Variable Generator", "Subsection",
 CellChangeTimes->{{3.5405125073730783`*^9, 3.540512550181526*^9}}],

Cell["\<\
11/29/2010

Based on the above idea\
\>", "Text",
 CellChangeTimes->{{3.540512560785133*^9, 3.5405125713707385`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"NormGen", "[", "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "u1", ",", " ", "u2", ",", " ", "x", ",", " ", "y", ",", " ", "s", ",",
         " ", "w", ",", " ", "z", ",", " ", "t"}], "}"}], ",", " ", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"While", "[", 
        RowBox[{"True", ",", " ", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"u1", "=", 
           RowBox[{"Random", "[", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"u2", "=", 
           RowBox[{"Random", "[", "]"}]}], ";", "\[IndentingNewLine]", 
          "\[IndentingNewLine]", 
          RowBox[{"x", "=", 
           RowBox[{
            RowBox[{"2", "u1"}], "-", "1"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"y", "=", 
           RowBox[{
            RowBox[{"2", "u2"}], "-", "1"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"s", "=", 
               RowBox[{
                SuperscriptBox["x", "2"], "+", 
                SuperscriptBox["y", "2"]}]}], ")"}], "<", "1"}], ",", " ", 
            RowBox[{"Return", "[", 
             RowBox[{
              SqrtBox[
               FractionBox[
                RowBox[{
                 RowBox[{"-", "2"}], 
                 RowBox[{"Log", "[", "s", "]"}]}], "s"]], 
              RowBox[{"{", 
               RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"w", "=", 
           RowBox[{
            RowBox[{"Abs", "[", "x", "]"}], "-", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"z", "=", 
           RowBox[{
            RowBox[{"Abs", "[", "y", "]"}], "-", "1"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"t", "=", 
               RowBox[{
                SuperscriptBox["w", "2"], "+", 
                SuperscriptBox["z", "2"]}]}], ")"}], "<", 
             RowBox[{"3", "-", 
              RowBox[{"2", 
               SqrtBox["2"]}]}]}], ",", " ", 
            RowBox[{"Return", "[", 
             RowBox[{
              SqrtBox[
               FractionBox[
                RowBox[{
                 RowBox[{"-", "2"}], 
                 RowBox[{"Log", "[", 
                  FractionBox["t", 
                   RowBox[{"3", "-", 
                    RowBox[{"2", 
                    SqrtBox["2"]}]}]], "]"}]}], "t"]], 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Sign", "[", "x", "]"}], "w"}], ",", " ", 
                RowBox[{
                 RowBox[{"Sign", "[", "y", "]"}], "z"}]}], "}"}]}], "]"}]}], 
           "]"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";"}]}], 
     "\[IndentingNewLine]", "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{"Graphics", "[", 
    RowBox[{
     RowBox[{"Point", "/@", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"NormGen", "[", "]"}], ",", " ", 
        RowBox[{"{", "10000", "}"}]}], "]"}]}], ",", 
     RowBox[{"AspectRatio", "\[Rule]", "Automatic"}]}], "]"}], "]"}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.5405125911648703`*^9, 3.540512593443001*^9}}],

