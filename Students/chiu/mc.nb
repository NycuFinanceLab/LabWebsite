Cell[CellGroupData[{

Cell["The Sum of 12 Uniform Variables", "Subsection",
 CellChangeTimes->{{3.512091498951048*^9, 3.512091513833474*^9}, {
  3.540518381253045*^9, 3.540518386326335*^9}}],

Cell["\<\
The first figure shows the plot of a standard normal random variable (red \
line) and that of the sum of 12 uniform variables (blue line). 
The second one shows their difference. \
\>", "Text",
 CellChangeTimes->{{3.5405183984870305`*^9, 3.5405184899422617`*^9}}],

