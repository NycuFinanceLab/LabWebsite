Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"2", 
     RowBox[{"(", 
      FractionBox["\[Pi]", "4"], ")"}]}], "+", 
    RowBox[{"NSum", "[", 
     RowBox[{
      RowBox[{"2", "i", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", 
          FractionBox["\[Pi]", "4"]}], ")"}], 
        RowBox[{"i", "-", "1"}]]}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"i", ",", "2", ",", " ", "\[Infinity]"}], "}"}]}], "]"}]}], 
   StyleBox[
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{
      "how", " ", "many", " ", "uniform", " ", "variables", " ", "are", " ", 
       "needed", " ", "to", " ", "generate", " ", "two", " ", "normal", " ", 
       "variables", " ", "on", " ", "average", " ", "in", " ", "the", " ", 
       "Box"}], "-", 
      RowBox[{"Muller", " ", 
       RowBox[{"algorithm", "?"}]}]}], " ", "*)"}],
    FontColor->RGBColor[1, 0, 0]], "\[IndentingNewLine]", 
