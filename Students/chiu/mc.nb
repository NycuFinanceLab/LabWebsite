Cell[CellGroupData[{

Cell["Monte Carlo Vanilla Option Pricing", "Section",
 CellChangeTimes->{{3.5405333423327694`*^9, 3.5405333658901167`*^9}, {
  3.540533442540501*^9, 3.5405334553992367`*^9}}],

Cell["\<\
Vanilla options are not path dependent, but here the sample path is generated \
to
1. plot the figure
2. make it easier to modify this code for path dependent option pricing\
\>", "Text",
 CellChangeTimes->{{3.5405342336397495`*^9, 3.5405342383060164`*^9}, {
  3.5405346930520267`*^9, 3.5405346963212132`*^9}, {3.540534730743182*^9, 
  3.5405347319902534`*^9}, {3.54053491218756*^9, 3.54053491882594*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"T", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"n", "=", "50"}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"number", " ", "of", " ", "periods"}], " ", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", "5000"}], ";"}], 
  RowBox[{"(*", " ", 
   RowBox[{"number", " ", "of", " ", "paths"}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dt", "=", 
    FractionBox["T", "n"]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", "0.1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"s", "=", "0.3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"s0", "=", "100"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"K", "=", "120"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"tmp", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fig", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"CPUtime", "=", 
   RowBox[{"TimeUsed", "[", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Do", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"z", "=", 
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", " ", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"aaa", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"{", "0", "}"}], ",", " ", 
         RowBox[{
          RowBox[{"RandomReal", "[", 
           RowBox[{"z", ",", " ", "n"}], "]"}], "//", "Accumulate"}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"aaa", "=", 
       RowBox[{"s0", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"r", "-", 
             FractionBox[
              SuperscriptBox["s", "2"], "2"]}], ")"}], 
           RowBox[{"Range", "[", 
            RowBox[{"0", ",", " ", "T", ",", " ", "dt"}], "]"}]}], "+", 
          RowBox[{"s", 
           SqrtBox["dt"], " ", "aaa"}]}], "]"}]}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"tmp", ",", " ", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "r"}], " ", "T"}]], 
         RowBox[{"Max", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"aaa", "//", "Last"}], ")"}], "-", "K"}], ",", " ", 
           "0"}], "]"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"fig", ",", " ", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{"aaa", ",", " ", 
          RowBox[{"PlotRange", "\[Rule]", "All"}], ",", " ", 
          RowBox[{"PlotStyle", "\[Rule]", 
           RowBox[{"{", 
            RowBox[{"Hue", "[", 
             RowBox[{"i", "/", "p"}], "]"}], "}"}]}]}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "p"}], "}"}]}], "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"some", " ", "sample", " ", "price", " ", "process"}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"fig", "[", 
    RowBox[{"[", 
     RowBox[{"Range", "[", 
      RowBox[{"1", ",", " ", "p", ",", " ", 
       FractionBox["p", "10"]}], "]"}], "]"}], "]"}], "//", "Show"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"sample", " ", "mean", " ", 
     RowBox[{"(", 
      RowBox[{"option", " ", "price"}], ")"}]}], ",", " ", 
    RowBox[{"sample", " ", "sd"}], ",", " ", 
    RowBox[{"and", " ", "running", " ", "time"}]}], " ", 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmp", "//", "Mean"}], "  "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmp", "//", "StandardDeviation"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TimeUsed", "[", "]"}], "-", "CPUtime"}], 
  " "}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{
  3.5133174398811646`*^9, {3.513317755496519*^9, 3.5133178349630585`*^9}, {
   3.513317916052001*^9, 3.513317968795694*^9}, {3.513318016328977*^9, 
   3.5133180623646584`*^9}, {3.5133180965911183`*^9, 3.513318149584411*^9}, {
