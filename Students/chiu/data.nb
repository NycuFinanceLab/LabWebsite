Cell[CellGroupData[{
Cell["Data & Histogram", "Title",
 CellChangeTimes->{{3.54055686413614*^9, 3.540556877674914*^9}}],

Cell[CellGroupData[{

Cell["DJI histogram", "Section",
 CellChangeTimes->{{3.5400260599088745`*^9, 3.5400260621300015`*^9}, {
