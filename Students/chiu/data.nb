      RowBox[{"ImageSize", "\[Rule]", "800"}]}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"sample", " ", "cumulant"}], " ", "*)"}]}], "\[IndentingNewLine]", 
