Cell["\:6c92\:6709\:7b54\:6848\:53ef\:4ee5\:5c0d\:ff0c\:4e0d\:80fd\:78ba\:5b9a\
\:662f\:4e0d\:662f\:5c0d\:7684", "Text",
 CellChangeTimes->{{3.5227318747612844`*^9, 3.522731887482012*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"s0", "=", "100"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K", "=", "120"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"r", "=", "0.1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s", "=", "0.3"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"T", "=", "1"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"n", "=", "50"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dt", "=", 
     RowBox[{"T", "/", "n"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "\:8981\:8a08\:7b97", " ", "A", " ", "\:7684\:5e7e\:968e", " ", 
     "moment"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k", "=", "12"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "F1", " ", "LowerDiagonalMatrix", " ", "\:6284\:904e\:4f86\:7684"}], " ", 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"LowerDiagonalMatrix", "[", 
      RowBox[{"f_", ",", 
       RowBox[{"n_Integer", "?", "NonNegative"}]}], "]"}], ":=", 
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"#", "\[GreaterEqual]", "#2"}], ",", 
          RowBox[{"f", "[", "##", "]"}], ",", "0"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "n"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "\:7d66\:51fa", " ", "x", " ", "\:7684", " ", "raw", " ", "moments", " ", 
     "\:548c\:4e8c\:9805\:5f0f\:77e9\:9663"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"distx", "=", 
     RowBox[{"LogNormalDistribution", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"r", "-", 
          FractionBox[
           SuperscriptBox["s", "2"], "2"]}], ")"}], "dt"}], ",", " ", 
       RowBox[{"s", 
        SqrtBox["dt"]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"binomatrix", "=", 
     RowBox[{"LowerDiagonalMatrix", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Binomial", "[", 
         RowBox[{
          RowBox[{"#1", "-", "1"}], ",", 
          RowBox[{"#2", "-", "1"}]}], "]"}], "&"}], ",", 
       RowBox[{"k", "+", "1"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rawx", "=", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"Moment", "[", 
         RowBox[{"distx", ",", " ", "i"}], "]"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"i", ",", " ", "0", ",", " ", "k"}], "}"}]}], "]"}], "//", 
      "DiagonalMatrix"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "\:7528\:77e9\:9663\:4e58\:6cd5\:8a08\:7b97", " ", "A", " ", 
      "\:7684\:5404\:968e", " ", "raw", " ", "moments"}], "\:ff0c", 
     RowBox[{"\:7528", " ", "Take", " ", "\:628a\:96f6\:968e\:780d\:6389"}]}],
     " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"rawa", "=", 
    RowBox[{"Take", "[", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox["s0", 
          RowBox[{"n", "+", "1"}]], ")"}], 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", " ", "k"}], "]"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"MatrixPower", "[", 
          RowBox[{
           RowBox[{"binomatrix", ".", "rawx"}], ",", " ", "n"}], "]"}], ".", 
         RowBox[{"Table", "[", 
          RowBox[{"1", ",", " ", 
           RowBox[{"{", 
            RowBox[{"k", "+", "1"}], "}"}]}], "]"}]}], ")"}]}], ",", " ", 
      RowBox[{"-", "k"}]}], "]"}]}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.522665007888275*^9, 3.5226651675804086`*^9}, {
   3.5226664864592295`*^9, 3.5226665274128504`*^9}, {3.522666562013711*^9, 
   3.5226665736981316`*^9}, {3.522666625568223*^9, 3.5226667963957434`*^9}, {
   3.5226669094072075`*^9, 3.5226669103522615`*^9}, {3.522666994429181*^9, 
   3.5226671004901*^9}, {3.5226672401810894`*^9, 3.522667282196493*^9}, {
   3.522667351147436*^9, 3.522667353199554*^9}, {3.522667577499118*^9, 
   3.5226676651556716`*^9}, 3.5226677215892825`*^9, {3.5226679266580114`*^9, 
   3.5226679323933396`*^9}, {3.5226683604928255`*^9, 3.522668367787243*^9}, {
