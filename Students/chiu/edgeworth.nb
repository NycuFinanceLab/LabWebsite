Cell[CellGroupData[{

Cell["\<\
Evaluate Cumulants With Raw Moments\
\>", "Section",
 CellChangeTimes->{{3.5226964912919416`*^9, 3.5226964982339544`*^9}, {
  3.5226966557318306`*^9, 3.522696666230649*^9}, {3.522734227722602*^9, 
  3.5227342586743727`*^9}, {3.540563866710664*^9, 3.5405638770092535`*^9}}],

Cell["\<\
\:524d\:5e7e\:9805\:5c0d wiki \:78ba\:5b9a\:662f\:5c0d\:7684\:3002
\:6709\:5167\:5efa\:7684 MomentConvert \:4f46\:4e0d\:77e5\:9053\:600e\:9ebc\
\:5957\:7528\:6240\:4ee5\:53ea\:80fd\:62ff\:4f86\:5c0d\:7b54\:6848\:3002\
\>", "Text",
 CellChangeTimes->{{3.522696667057451*^9, 3.5226966842954807`*^9}, {
  3.5228886392945414`*^9, 3.5228886420713463`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"rawtest", "=", 
     RowBox[{"{", 
      RowBox[{
      "r1", ",", " ", "r2", ",", " ", "r3", ",", " ", "r4", ",", " ", "r5", 
       ",", " ", "r6", ",", " ", "r7", ",", " ", "r8", ",", " ", "r9", ",", 
       " ", "r10", ",", " ", "r11", ",", " ", "r12", ",", " ", "r13", ",", 
       " ", "r14", ",", " ", "r15", ",", " ", "r16", ",", " ", "r17", ",", 
       " ", "r18", ",", " ", "r19", ",", " ", "r20"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cum", "=", 
     RowBox[{"{", 
      RowBox[{"rawtest", "[", 
       RowBox[{"[", "1", "]"}], "]"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "2"}], ",", " ", 
     RowBox[{"i", "\[LessEqual]", "k"}], ",", " ", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"AppendTo", "[", 
       RowBox[{"cum", ",", " ", 
        RowBox[{
         RowBox[{"rawtest", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "-", 
         RowBox[{"Sum", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"Binomial", "[", 
              RowBox[{
               RowBox[{"i", "-", "1"}], ",", " ", 
               RowBox[{"p", "-", "1"}]}], "]"}], 
             RowBox[{"cum", "[", 
              RowBox[{"[", "p", "]"}], "]"}], 
             RowBox[{"rawtest", "[", 
              RowBox[{"[", 
