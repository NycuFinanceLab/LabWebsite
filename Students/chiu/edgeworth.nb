Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dd", "=", 
   RowBox[{"LogNormalDistribution", "[", 
    RowBox[{
     RowBox[{"Log", "[", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"rawa", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "2"], 
       SqrtBox[
        RowBox[{"rawa", "[", 
         RowBox[{"[", "2", "]"}], "]"}]]], "]"}], ",", " ", 
     SqrtBox[
      RowBox[{"Log", "[", 
       FractionBox[
        RowBox[{"rawa", "[", 
         RowBox[{"[", "2", "]"}], "]"}], 
        SuperscriptBox[
         RowBox[{"rawa", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "2"]], "]"}]]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Moment", "[", 
    RowBox[{"dd", ",", " ", "i"}], "]"}], ",", " ", 
