Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"EdgeworthSeries", "[", 
   RowBox[{
    RowBox[{"p_", "/;", 
     RowBox[{"p", "\[GreaterEqual]", "2"}]}], ",", "y_"}], "]"}], ":=", 
  RowBox[{"With", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"z", "=", 
       RowBox[{"(", 
        RowBox[{"y", "-", 
         RowBox[{"Cumulant", "[", "1", "]"}]}], ")"}]}], ",", 
      RowBox[{"\[Sigma]", "=", 
       SqrtBox[
        RowBox[{"Cumulant", "[", "2", "]"}]]}]}], "}"}], ",", 
    RowBox[{
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", "\[Sigma]"}], "]"}], ",", "z"}], "]"}], 
     RowBox[{"(", 
      RowBox[{"1", "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          FractionBox[
           SuperscriptBox["\[Sigma]", "s"], 
           RowBox[{
            SuperscriptBox["2", 
             RowBox[{
              FractionBox["s", "2"], "+", "r"}]], 
            RowBox[{"s", "!"}]}]], 
          RowBox[{"HermiteH", "[", 
           RowBox[{
            RowBox[{"s", "+", 
             RowBox[{"2", "r"}]}], ",", 
            FractionBox["z", 
             RowBox[{
              SqrtBox["2"], "\[Sigma]"}]]}], "]"}], 
          RowBox[{"BellY", "[", 
           RowBox[{"s", ",", "r", ",", 
            RowBox[{"Table", "[", 
             RowBox[{
              FractionBox[
               RowBox[{"Cumulant", "[", "k", "]"}], 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"k", "-", "1"}], ")"}], "k", " ", 
                SuperscriptBox["\[Sigma]", 
                 RowBox[{
                  RowBox[{"2", "k"}], "-", "2"}]]}]], ",", 
              RowBox[{"{", 
               RowBox[{"k", ",", "3", ",", "p"}], "}"}]}], "]"}]}], "]"}]}], 
         ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", 
           RowBox[{"p", "-", "2"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"r", ",", "s"}], "}"}]}], "]"}]}], ")"}]}]}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"dist", "=", 
   RowBox[{"SechDistribution", "[", 
    RowBox[{"1", ",", "2"}], "]"}]}], ";"}], "\n", 
