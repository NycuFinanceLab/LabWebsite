Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"using", " ", 
    RowBox[{"Simpson", "'"}], "s", " ", "rule", " ", "to", " ", "integrate", 
    " ", 
    RowBox[{"f", "[", "x", "]"}], " ", "from", " ", "a", " ", "to", " ", 
    "b"}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"n", " ", "must", " ", "be", " ", "even"}], " ", "*)"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Simp", "[", 
      RowBox[{"f_", ",", " ", "n_", ",", " ", "a_", ",", " ", "b_"}], "]"}], ":=",
      " ", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"grids", ",", " ", "tmp", ",", " ", "coeff"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"grids", " ", "=", " ", 
         RowBox[{"Range", "[", 
          RowBox[{"a", ",", " ", "b", ",", " ", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"tmp", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"f", "[", 
            RowBox[{"grids", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", 
             RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"coeff", " ", "=", " ", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{"OddQ", "[", "i", "]"}], ",", " ", "4", ",", " ", "2"}], 
            "]"}], ",", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", " ", "1", ",", " ", 
             RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"coeff", " ", "=", " ", 
         RowBox[{"Prepend", "[", 
          RowBox[{"coeff", ",", " ", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"coeff", " ", "=", " ", 
         RowBox[{
          RowBox[{"Append", "[", 
           RowBox[{"coeff", ",", " ", "1"}], "]"}], "/", "3"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"tmp", ".", "coeff"}], 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], ",", " ", "60"}], 
          "]"}], "//", "Return"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", "result", " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Simp", "[", 
    RowBox[{"Sin", ",", " ", "100", ",", " ", "0", ",", " ", "Pi"}], "]"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"for", " ", "more", " ", "digits"}], ",", " ", 
     RowBox[{
     "press", " ", "any", " ", "key", " ", "in", " ", "output", " ", 
      "cell"}]}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{"Sin", "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", "0", ",", " ", "Pi"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.5406291056991205`*^9, 3.5406292034187098`*^9}}],

