Cell[CellGroupData[{

Cell["Using CRR Tree As An Example", "Subsection",
 CellChangeTimes->{{3.539518595667626*^9, 3.5395186008649235`*^9}, {
  3.5397516327749133`*^9, 3.5397516334145145`*^9}, {3.540629829600526*^9, 
  3.540629874273081*^9}, {3.540982809650337*^9, 3.5409828190268736`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "s0", ",", " ", "K", ",", " ", "r", ",", " ", "T", ",", " ", "\[Sigma]", 
     ",", " ", "n", ",", " ", "dt", ",", " ", "u", ",", " ", "d", ",", " ", 
     "p", ",", " ", "c"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"s0", "=", "40"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K", "=", "40"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"r", "=", "0.05"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"T", "=", "3"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Sigma]", "=", "0.2"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "1000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dt", "=", 
    RowBox[{"T", "/", "n"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"u", "=", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"\[Sigma]", " ", 
     SqrtBox["dt"]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"d", "=", 
   RowBox[{"1", "/", "u"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p", "=", 
    FractionBox[
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"r", " ", "dt"}]], "-", "d"}], 
     RowBox[{"u", "-", "d"}]]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ini", "=", 
    RowBox[{"TimeUsed", "[", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"n", "+", "1"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"For", "[", 
   RowBox[{
    RowBox[{"i", "=", "1"}], ",", " ", 
    RowBox[{"i", "\[LessEqual]", 
     RowBox[{"n", "+", "1"}]}], ",", " ", 
    RowBox[{"i", "++"}], ",", " ", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"c", "[", 
      RowBox[{"[", "i", "]"}], "]"}], "=", 
     RowBox[{"Max", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"s0", " ", 
         SuperscriptBox["u", 
          RowBox[{"n", "-", "i", "+", "1"}]], 
         SuperscriptBox["d", 
          RowBox[{"i", "-", "1"}]]}], "-", "K"}], ",", " ", "0"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"i", "=", "n"}], ",", " ", 
     RowBox[{"i", "\[GreaterEqual]", "0"}], ",", " ", 
     RowBox[{"i", "--"}], ",", "\[IndentingNewLine]", 
     RowBox[{"For", "[", 
      RowBox[{
       RowBox[{"j", "=", "1"}], ",", " ", 
       RowBox[{"j", "\[LessEqual]", "i"}], ",", " ", 
       RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"c", "[", 
         RowBox[{"[", "j", "]"}], "]"}], "=", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", "r"}], " ", "dt"}]], 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"p", " ", 
            RowBox[{"c", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"1", "-", "p"}], ")"}], 
            RowBox[{"c", "[", 
             RowBox[{"[", 
              RowBox[{"j", "+", "1"}], "]"}], "]"}]}]}], ")"}]}]}]}], 
      "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"c", "[", 
   RowBox[{"[", "1", "]"}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
