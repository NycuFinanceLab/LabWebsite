Cell[CellGroupData[{

Cell["\<\
The Error Introduced by The Trapezoidal Rule, And The Simpson\
\[CloseCurlyQuote] Rule\
\>", "Section",
 CellChangeTimes->{{3.540563180114393*^9, 3.5405632423829546`*^9}}],

Cell[TextData[{
 "12/14/2010\n\nThe log-log plot shows that the trapezoidal rule has an error \
convergence rate of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["h", "2"], ")"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", and the Simpson\[CloseCurlyQuote]s rule has an error convergence rate of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"O", "(", 
    SuperscriptBox["h", "4"], ")"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ". \nThe function of the line that best fits the points ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     RowBox[{"log", " ", "h"}], ",", " ", 
     RowBox[{"log", " ", "|", "error", "|"}]}], ")"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " is given. "
}], "Text",
 CellChangeTimes->{{3.540562888159694*^9, 3.540563031074868*^9}, {
  3.540563085739995*^9, 3.540563171625908*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Simp", "[", 
     RowBox[{"f_", ",", " ", "n_", ",", " ", "a_", ",", " ", "b_"}], "]"}], ":=",
     " ", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"grids", ",", " ", "tmp", ",", " ", "coeff"}], "}"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{"using", " ", 
         RowBox[{"simpson", "'"}], "s", " ", "rule", " ", "to", " ", 
         "integrate", " ", "f"}], ",", " ", 
        RowBox[{"from", " ", "a", " ", "to", " ", "b"}]}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"grids", " ", "=", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"a", ",", " ", "b", ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tmp", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"grids", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "1", ",", " ", 
            RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coeff", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"OddQ", "[", "i", "]"}], ",", " ", "4", ",", " ", "2"}], 
           "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "1", ",", " ", 
            RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coeff", " ", "=", " ", 
        RowBox[{"Prepend", "[", 
         RowBox[{"coeff", ",", " ", "1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coeff", " ", "=", " ", 
        RowBox[{
         RowBox[{"Append", "[", 
          RowBox[{"coeff", ",", " ", "1"}], "]"}], "/", "3"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tmp", ".", "coeff"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], ",", " ", "60"}], 
         "]"}], "//", "Return"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Trap", "[", 
     RowBox[{"f_", ",", " ", "n_", ",", " ", "a_", ",", " ", "b_"}], "]"}], ":=",
     " ", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"grids", ",", " ", "tmp", ",", " ", "coeff"}], "}"}], ",", " ", 
      RowBox[{"(*", " ", 
       RowBox[{"trapezoidal", " ", "rule"}], " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"grids", " ", "=", " ", 
        RowBox[{"Range", "[", 
         RowBox[{"a", ",", " ", "b", ",", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"tmp", " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"f", "[", 
           RowBox[{"grids", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"i", ",", " ", "1", ",", " ", 
            RowBox[{"n", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"coeff", " ", "=", " ", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", "/", "2"}], "}"}], ",", " ", 
          RowBox[{"Table", "[", 
           RowBox[{"1", ",", " ", 
            RowBox[{"{", 
             RowBox[{"n", "-", "1"}], "}"}]}], "]"}], ",", " ", 
          RowBox[{"{", 
           RowBox[{"1", "/", "2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"N", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"tmp", ".", "coeff"}], 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], ",", " ", "60"}], 
         "]"}], "//", "Return"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   SuperscriptBox["\[ExponentialE]", "x"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"b", "=", "1"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"exact", " ", "=", " ", 
    RowBox[{"Integrate", "[", 
     RowBox[{
      RowBox[{"f", "[", "x", "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", "a", ",", " ", "b"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  StyleBox[
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{"Simpson", "'"}], "s", " ", "rule"}], " ", "*)"}],
   FontColor->RGBColor[1, 0, 0]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"simppts", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Log", "[", 
        FractionBox["1", 
         RowBox[{
          SuperscriptBox["2", "i"], "10"}]], "]"}], ",", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Simp", "[", 
           RowBox[{"f", ",", " ", 
            RowBox[{
             SuperscriptBox["2", "i"], "10"}], ",", " ", "a", ",", " ", "b"}],
            "]"}], "-", "exact"}], "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", "10"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Fit", "[", 
  RowBox[{"simppts", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "x"}], "}"}], ",", " ", "x"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{"%", ",", " ", 
      RowBox[{"{", 
       RowBox[{"x", ",", " ", 
        RowBox[{"-", "10"}], ",", " ", 
        RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"simppts", ",", " ", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"PointSize", "[", ".02", "]"}]}]}], "]"}], ",", " ", 
    RowBox[{"ImageSize", "\[Rule]", "400"}]}], "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  StyleBox[
   RowBox[{"(*", " ", 
    RowBox[{"Trapezoidal", " ", "rule"}], " ", "*)"}],
   FontColor->RGBColor[1, 0, 0]]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"trappts", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Log", "[", 
        FractionBox["1", 
         RowBox[{
          SuperscriptBox["2", "i"], "10"}]], "]"}], ",", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"Abs", "[", 
         RowBox[{
          RowBox[{"Trap", "[", 
           RowBox[{"f", ",", " ", 
            RowBox[{
             SuperscriptBox["2", "i"], "10"}], ",", " ", "a", ",", " ", "b"}],
            "]"}], "-", "exact"}], "]"}], "]"}]}], "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"i", ",", " ", "1", ",", " ", "10"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Fit", "[", 
  RowBox[{"trappts", ",", " ", 
   RowBox[{"{", 
    RowBox[{"1", ",", " ", "x"}], "}"}], ",", " ", "x"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{"%", ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "10"}], ",", " ", 
       RowBox[{"-", "2"}]}], "}"}]}], "]"}], ",", " ", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"trappts", ",", " ", 
     RowBox[{"PlotStyle", "\[Rule]", 
      RowBox[{"PointSize", "[", ".02", "]"}]}]}], "]"}], ",", " ", 
   RowBox[{"ImageSize", "\[Rule]", "400"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{
  3.5405175057669697`*^9, {3.54056282392302*^9, 3.5405628844914846`*^9}}],

