Cell[CellGroupData[{

Cell["More Efficiently", "Subsection",
 CellChangeTimes->{{3.54056120897865*^9, 3.5405612307988987`*^9}}],

Cell[TextData[{
 "Recently I designed an algorithm that evaluates ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " really frequently. \nIn this case, both of the above are not the best \
choice. \nIf one can withstand an error of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "7"}]], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", keeping 1201 exact values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " between [-6, 6] and using qudratic interpolation will work more \
efficiently. \nWhen ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],
  FormatType->"TraditionalForm"],
 " is out of the interval [-6, 6], we set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " to 0 or 1. \nThe error caused in this part this is, as shown in the \
following computations, always less than ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "9"}]], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ". \n\nBesides, althought the error due to qudratic interpolations depends \
on the derivative of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", as shown in the figure, its absolute value is quite small. "
}], "Text",
 CellChangeTimes->{{3.5369895780720367`*^9, 3.536989634788281*^9}, {
   3.5369896648690014`*^9, 3.5369896895774145`*^9}, {3.536989819631853*^9, 
   3.536989924624859*^9}, {3.5369900411225224`*^9, 3.536990096630697*^9}, {
   3.5369901559780912`*^9, 3.5369901591172705`*^9}, {3.5405609293836584`*^9, 
   3.5405609295956707`*^9}, 3.540561064848407*^9, {3.5405612347841263`*^9, 
   3.5405612710412006`*^9}, {3.5405614085730667`*^9, 3.5405614108591976`*^9}, 
   3.5405614946299887`*^9, {3.5405615310490723`*^9, 3.5405615936266513`*^9}, {
   3.540561634634997*^9, 3.5405620227651963`*^9}, {3.540562249845185*^9, 
   3.540562284436163*^9}, {3.54056234820481*^9, 3.540562381340706*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Ncdf", "[", "x_", "]"}], ":=", 
     FractionBox[
      RowBox[{"1", "+", 
       RowBox[{"Erf", "[", 
        FractionBox["x", 
         SqrtBox["2"]], "]"}]}], "2"]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Ncdf", "[", "x", "]"}], "\[Equal]", 
      SuperscriptBox["10", 
       RowBox[{"-", "9"}]]}], ",", " ", "x"}], "]"}], "\[IndentingNewLine]", 
   RowBox[{"NSolve", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Ncdf", "[", "x", "]"}], "\[Equal]", 
      RowBox[{"1", "-", 
       SuperscriptBox["10", 
        RowBox[{"-", "9"}]]}]}], ",", " ", "x"}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Ncdf", "''''"}], "[", "x", "]"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"x", ",", " ", 
       RowBox[{"-", "5"}], ",", " ", "5"}], "}"}]}], "]"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.540561942527607*^9, 3.540561946392828*^9}, {
  3.5405620911221066`*^9, 3.540562091327118*^9}, {3.5405622911555476`*^9, 
  3.5405622921706057`*^9}}],

