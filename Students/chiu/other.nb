Cell[CellGroupData[{

Cell["Newton-Cotes Coefficients", "Section",
 CellChangeTimes->{{3.540562795143374*^9, 3.540562795406389*^9}}],

Cell[CellGroupData[{

Cell["\<\
Integrating The Lagrange Basis Polynomials\
\>", "Subsection",
 CellChangeTimes->{{3.5405625175424957`*^9, 3.5405625208156834`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"Coeff", "[", 
     RowBox[{"n_", ",", " ", "j_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "qq", "}"}], ",", " ", 
      StyleBox[
       RowBox[{"(*", " ", 
        RowBox[{
        "n", " ", "\:500b\:9ede\:4e4b\:4e2d\:7a4d\:524d", " ", "j", " ", 
         "\:500b\:9ede\:7684\:7a4d\:5206\:4fc2\:6578"}], " ", "*)"}],
       FontColor->RGBColor[1, 0, 0]], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"qq", "=", 
           RowBox[{"Table", "[", 
            RowBox[{"0", ",", " ", 
             RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"qq", "[", 
            RowBox[{"[", "k", "]"}], "]"}], "=", "1"}], ";", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"Integrate", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"InterpolatingPolynomial", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Range", "[", "n", "]"}], ",", " ", "qq"}], "}"}], "//",
                "Transpose"}], ",", " ", "x"}], "]"}], "\[IndentingNewLine]", 
            ",", " ", 
            RowBox[{"{", 
             RowBox[{"x", ",", " ", "1", ",", " ", "j"}], "}"}]}], "]"}]}], 
         "\[IndentingNewLine]", ",", " ", 
         RowBox[{"{", 
          RowBox[{"k", ",", " ", "1", ",", " ", "n"}], "}"}]}], "]"}], "//", 
       "Return"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Coeff", "[", 
    RowBox[{"3", ",", " ", "3"}], "]"}], 
   StyleBox[
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Simpson", "'"}], "s", " ", "rule"}], " ", "*)"}],
    FontColor->RGBColor[1, 0, 0]], "\[IndentingNewLine]", 
   RowBox[{"Coeff", "[", 
    RowBox[{"5", ",", " ", "5"}], "]"}], 
   StyleBox[
    RowBox[{"(*", " ", 
     RowBox[{
      RowBox[{"Boole", "'"}], "s", " ", "rule"}], " ", "*)"}],
    FontColor->RGBColor[1, 0, 0]], 
   StyleBox["\[IndentingNewLine]",
    FontColor->RGBColor[1, 0, 0]]}]}]], "Input",
 CellChangeTimes->{{3.5405627821976337`*^9, 3.5405627870049086`*^9}}],

