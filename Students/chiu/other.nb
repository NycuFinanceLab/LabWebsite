Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"Ncdf0", ",", " ", "Ncdf1", ",", " ", "Ncdf2", ",", " ", "Ncdf"}],
     "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ncdf", "[", "x_", "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "p", ",", " ", "sg", ",", " ", "a1", ",", " ", "a2", ",", " ", "a3", 
       ",", " ", "a4", ",", " ", "a5"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"a1", "=", "0.319381530"}], ";", "\[IndentingNewLine]", 
      RowBox[{"a2", "=", 
       RowBox[{"-", "0.356563782"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"a3", "=", "1.781477937"}], ";", "\[IndentingNewLine]", 
      RowBox[{"a4", "=", 
       RowBox[{"-", "1.821255978"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"a5", "=", "1.330274429"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"sg", "=", 
       RowBox[{"Sign", "[", 
        RowBox[{"Re", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"p", "=", 
       FractionBox["1", 
        RowBox[{"1", "+", 
         RowBox[{"sg", " ", "0.2316419", " ", "x"}]}]]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"0.5", "+", 
        RowBox[{"0.5", "sg"}], "-", 
        RowBox[{"sg", 
         FractionBox["1", 
          SqrtBox[
           RowBox[{"2", "\[Pi]"}]]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{"-", 
           FractionBox[
            SuperscriptBox["x", "2"], "2"]}]], "p", " ", 
         RowBox[{"(", 
          RowBox[{"a1", "+", 
           RowBox[{"p", " ", 
            RowBox[{"(", 
             RowBox[{"a2", "+", 
              RowBox[{"p", " ", 
               RowBox[{"(", 
                RowBox[{"a3", "+", 
                 RowBox[{"p", " ", 
                  RowBox[{"(", 
                   RowBox[{"a4", "+", 
                    RowBox[{"a5", " ", "p"}]}], ")"}]}]}], ")"}]}]}], 
             ")"}]}]}], ")"}]}]}], "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Ncdf", "[", "x", "]"}], "-", 
