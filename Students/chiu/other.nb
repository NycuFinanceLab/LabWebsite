Cell[BoxData["0.7225942673706999`"], "Output",
 CellChangeTimes->{3.5292016005505724`*^9, 3.529201728582396*^9, 
  3.5292018031973267`*^9, 3.5292018385469894`*^9, 3.540560109351755*^9}]
}, Open  ]]
}, Closed]],

Cell[CellGroupData[{

Cell["Notes on Error & Efficiency", "Subsection",
 CellChangeTimes->{{3.532766495447446*^9, 3.53276649953868*^9}, {
  3.5405603044039116`*^9, 3.5405603280772657`*^9}, {3.5405611297721205`*^9, 
  3.540561136276492*^9}}],

Cell[TextData[{
 "Using built-in function, one can obtain almost exact values. \nIn \
constrast, the widely used approximation could introduce an errof of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "7"}]], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", as shown in the figure. \nBut, as experiments show us, using built-in \
functions to evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " is very inefficient. \nIf an algorithm involves ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 " frequently, and if one can withstand an error of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["10", 
    RowBox[{"-", "7"}]], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", the widely used approximation is a better choice. "
}], "Text",
 CellChangeTimes->{{3.5405602825116596`*^9, 3.540560298588579*^9}, {
  3.540560337690816*^9, 3.5405603646943603`*^9}, {3.5405603962841673`*^9, 
  3.5405604580246983`*^9}, {3.540560570386125*^9, 3.5405606228281245`*^9}, {
  3.540560726148034*^9, 3.5405608906534433`*^9}, {3.5405609932963142`*^9, 
  3.54056099986269*^9}, {3.540561045462298*^9, 3.5405610468703785`*^9}, {
  3.540561422179845*^9, 3.5405614250300083`*^9}}],

