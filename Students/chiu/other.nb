 CellChangeTimes->{3.5292016005505724`*^9, 3.529201728582396*^9, 
  3.5292018031973267`*^9, 3.5292018385469894`*^9, 3.5405601093347545`*^9}],

Cell[BoxData["0.7225942176896503`"], "Output",
