Cell[CellGroupData[{
Cell["Other Topics", "Title",
 CellChangeTimes->{{3.540439465799339*^9, 3.5404394697265635`*^9}, {
  3.540444438568765*^9, 3.5404444403868694`*^9}, {3.5405636717635136`*^9, 
  3.5405636760277576`*^9}}],

Cell[CellGroupData[{

Cell["Ncdf", "Section",
 CellChangeTimes->{{3.529201538178463*^9, 3.529201546196877*^9}}],

Cell[CellGroupData[{

Cell[TextData[{
 "Different Ways To Evaluate ",
 Cell[BoxData[
  FormBox[
   RowBox[{"N", 
    RowBox[{"(", "x", ")"}]}], TraditionalForm]]],
 " in ",
 StyleBox["Mathematica",
  FontSlant->"Italic"],
 " "
}], "Subsection",
 CellChangeTimes->{{3.5395190979083524`*^9, 3.539519119822606*^9}, {
   3.540560128767866*^9, 3.5405601526192303`*^9}, {3.540561102576565*^9, 
   3.540561116399355*^9}, 3.540565801578332*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"built", "-", 
    RowBox[{"in", " ", "functions"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Ncdf0", "[", "x_", "]"}], ":=", 
     FractionBox[
      RowBox[{"1", "+", 
       RowBox[{"Erf", "[", 
        FractionBox["x", 
         SqrtBox["2"]], "]"}]}], "2"]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ncdf1", "[", "x_", "]"}], ":=", 
     RowBox[{"CDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"0", ",", " ", "1"}], "]"}], ",", "x"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{"see", " ", "John", " ", "Hull"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ncdf2", "[", "x_", "]"}], ":=", 
     RowBox[{"Block", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "p", ",", " ", "sg", ",", " ", "a1", ",", " ", "a2", ",", " ", "a3", 
         ",", " ", "a4", ",", " ", "a5"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"a1", "=", "0.319381530"}], ";", "\[IndentingNewLine]", 
        RowBox[{"a2", "=", 
         RowBox[{"-", "0.356563782"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"a3", "=", "1.781477937"}], ";", "\[IndentingNewLine]", 
        RowBox[{"a4", "=", 
         RowBox[{"-", "1.821255978"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"a5", "=", "1.330274429"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"sg", "=", 
         RowBox[{"Sign", "[", 
          RowBox[{"Re", "[", "x", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"p", "=", 
         FractionBox["1", 
          RowBox[{"1", "+", 
           RowBox[{"sg", " ", "0.2316419", " ", "x"}]}]]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", 
         RowBox[{"0.5", "+", 
          RowBox[{"0.5", "sg"}], "-", 
          RowBox[{"sg", 
           FractionBox["1", 
            SqrtBox[
             RowBox[{"2", "\[Pi]"}]]], 
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{"-", 
             FractionBox[
              SuperscriptBox["x", "2"], "2"]}]], "p", " ", 
           RowBox[{"(", 
            RowBox[{"a1", "+", 
             RowBox[{"p", " ", 
              RowBox[{"(", 
               RowBox[{"a2", "+", 
                RowBox[{"p", " ", 
                 RowBox[{"(", 
                  RowBox[{"a3", "+", 
                   RowBox[{"p", " ", 
                    RowBox[{"(", 
                    RowBox[{"a4", "+", 
                    RowBox[{"a5", " ", "p"}]}], ")"}]}]}], ")"}]}]}], 
               ")"}]}]}], ")"}]}]}], "]"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"a", "=", 
    RowBox[{"RandomReal", "[", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Ncdf0", "[", "a", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Ncdf1", "[", "a", "]"}], "\[IndentingNewLine]", 
   RowBox[{"Ncdf2", "[", "a", "]"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.5292015480220804`*^9, 3.5292015644957094`*^9}, {
   3.5292017133723693`*^9, 3.5292018370493865`*^9}, {3.540559781165984*^9, 
   3.5405598118607397`*^9}, 3.540559916485724*^9, {3.540559967313631*^9, 
   3.540560108661716*^9}}],

