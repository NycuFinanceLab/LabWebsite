Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"BermudanGBM", "[", 
     RowBox[{
     "s0_", ",", "K_", ",", "r_", ",", "\[Sigma]_", ",", "T_", ",", "M_", ",",
       "c_", ",", "m_", ",", "ordd_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "CPUtime", ",", "dt", ",", "h", ",", "g", ",", "V", ",", "yaxis", ",", 
        "payoff", ",", "glist", ",", "putvalue", ",", "Bervalue"}], "}"}], 
      ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"CPUtime", "=", 
        RowBox[{"TimeUsed", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dt", "=", 
        RowBox[{"T", "/", "M"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"h", "=", 
        FractionBox[
         RowBox[{"2", "c"}], "m"]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"g", "[", "w_", "]"}], ":=", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"\[Sigma]", 
           SqrtBox[
            RowBox[{"2", "\[Pi]", " ", "dt"}]]}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", 
             RowBox[{"2", "dt"}]]}], 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"w", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", "-", 
                  FractionBox[
                   SuperscriptBox["\[Sigma]", "2"], "2"]}], ")"}], " ", 
                "dt"}]}], "\[Sigma]"], ")"}], "2"]}]]}]}], ";", "   ", 
       RowBox[{"(*", " ", "y\:7684\:5206\:914d\:5f62\:5f0f", " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"V", "[", "x_", "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"x", "\[LessEqual]", "0"}], ",", 
          RowBox[{"K", 
           RowBox[{"(", 
            RowBox[{"1", "-", 
             SuperscriptBox["\[ExponentialE]", "x"]}], ")"}]}], ",", "0"}], 
         "]"}]}], ";", "\n", "\[IndentingNewLine]", 
       RowBox[{"yaxis", "=", 
