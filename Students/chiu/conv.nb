Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"DownOutGBM", "[", 
    RowBox[{
    "s0_", ",", "K_", ",", "H_", ",", "r_", ",", "\[Sigma]_", ",", "T_", ",", 
     "n_", ",", "c_", ",", "m_", ",", "ordd_"}], "]"}], ":=", 
   RowBox[{"Block", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "CPUtime", ",", "logBarr", ",", "dt", ",", "h", ",", "g", ",", "V", ",",
        "yaxis", ",", "payoff", ",", "glist", ",", "value", ",", 
       "Barriervalue"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"CPUtime", "=", 
       RowBox[{"TimeUsed", "[", "]"}]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"logBarr", "=", 
       RowBox[{"Log", "[", 
        FractionBox["H", "K"], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"dt", "=", 
       RowBox[{"T", "/", "n"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"h", "=", 
       FractionBox[
        RowBox[{"2", "c"}], "m"]}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"g", "[", "w_", "]"}], ":=", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"\[Sigma]", 
          SqrtBox[
           RowBox[{"2", "\[Pi]", " ", "dt"}]]}]], 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["1", 
            RowBox[{"2", "dt"}]]}], 
          SuperscriptBox[
           RowBox[{"(", 
            FractionBox[
             RowBox[{"w", "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"r", "-", 
                 FractionBox[
                  SuperscriptBox["\[Sigma]", "2"], "2"]}], ")"}], " ", 
               "dt"}]}], "\[Sigma]"], ")"}], "2"]}]]}]}], ";", "   ", 
      RowBox[{"(*", " ", "y\:7684\:5206\:914d\:5f62\:5f0f", " ", "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"V", "[", "x_", "]"}], ":=", 
       RowBox[{"If", "[", 
        StyleBox[
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"x", ">=", "logBarr"}], " ", "&&"}], "*)"}],
         FontColor->RGBColor[1, 0, 0]], " ", 
        RowBox[{
         RowBox[{"x", ">=", "0"}], ",", 
         RowBox[{"K", 
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", "x"], "-", "1"}], ")"}]}], ",", 
         "0"}], "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"yaxis", "=", 
       RowBox[{"Range", "[", 
        RowBox[{
         RowBox[{"-", "c"}], ",", "c", ",", "h"}], "]"}]}], ";", "   ", 
      "\[IndentingNewLine]", 
      RowBox[{"payoff", "=", 
       RowBox[{
        RowBox[{"V", "/@", "yaxis"}], "//", "N"}]}], ";", "         ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"yaxis", ",", " ", "payoff"}], "}"}], "//", "Transpose"}], "//",
         "ListPlot"}], " ", "*)"}], 
      RowBox[{"(*", " ", 
       RowBox[{"\:5230\:671f\:65e5\:6642", ",", 
        RowBox[{"opion2", " ", "\:7684\:50f9\:503c"}], ",", 
        "\:8a18\:6210payoff"}], " ", "*)"}], "\[IndentingNewLine]", 
      RowBox[{"glist", "=", 
       RowBox[{
        RowBox[{"g", "/@", "yaxis"}], "//", "N"}]}], ";", "   ", 
      RowBox[{"(*", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"m", "+", "1"}], ")"}], 
         "\:500by\:7684\:6a5f\:7387\:5206\:914d\:503c"}], ",", 
        RowBox[{"density", " ", "value"}], ",", "\:8a18\:6210glist"}], " ", 
       "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"value", "=", "payoff"}], ";", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", 
      RowBox[{"For", "[", 
       RowBox[{
        RowBox[{"l", "=", "1"}], ",", 
        RowBox[{"l", "\[LessEqual]", "n"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"value", "=", 
          RowBox[{
           SuperscriptBox["\[ExponentialE]", 
            RowBox[{
             RowBox[{"-", "r"}], " ", "dt"}]], " ", "h", " ", 
           RowBox[{"Convol", "[", 
            RowBox[{"glist", ",", "value", ",", "ordd"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"value", "=", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"yaxis", "[", 
                RowBox[{"[", "j", "]"}], "]"}], "\[GreaterEqual]", 
               "logBarr"}], ",", 
              RowBox[{"value", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", "0"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "1", ",", 
              RowBox[{"Length", "[", "yaxis", "]"}]}], "}"}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"l", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Barriervalue", "=", 
