         " ", 
         RowBox[{"ordd", "-", "1"}], ",", " ", 
         RowBox[{"Log", "[", 
          FractionBox["s0", "K"], "]"}]}], "]"}]}], " ", ";", 
      RowBox[{"(*", " ", 
