Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Coeff", "[", 
     RowBox[{"n_", ",", " ", "j_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", "zeros", "}"}], ",", "\[IndentingNewLine]", 
