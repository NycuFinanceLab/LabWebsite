\>", "Text"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{
    "MyPlot", ",", "Convol", ",", "Intp", ",", "CPUtime", ",", "s0", ",", "K",
