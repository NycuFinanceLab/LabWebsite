Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Compound", "[", 
     RowBox[{
     "s0_", ",", "Klist_", ",", "r_", ",", "\[Sigma]_", ",", "T_", ",", "c_", 
      ",", "m_", ",", "ordd_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "CPUtime", ",", "dt", ",", "h", ",", "g", ",", "V", ",", "yaxis", ",", 
        "payoff", ",", "glist", ",", "value"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"CPUtime", "=", 
        RowBox[{"TimeUsed", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"n", "=", 
        RowBox[{"Length", "[", "Klist", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"dt", "=", 
        RowBox[{"T", "/", "n"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"h", "=", 
        FractionBox[
         RowBox[{"2", "c"}], "m"]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"g", "[", "w_", "]"}], ":=", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"\[Sigma]", 
           SqrtBox[
            RowBox[{"2", "\[Pi]", " ", "dt"}]]}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", 
             RowBox[{"2", "dt"}]]}], 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"w", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", "-", 
                  FractionBox[
                   SuperscriptBox["\[Sigma]", "2"], "2"]}], ")"}], " ", 
                "dt"}]}], "\[Sigma]"], ")"}], "2"]}]]}]}], ";", "   ", 
       RowBox[{"(*", " ", "y\:7684\:5206\:914d\:5f62\:5f0f", " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"V", "[", "x_", "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"x", "\[GreaterEqual]", "0"}], ",", 
          RowBox[{
           RowBox[{"Klist", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], 
           SuperscriptBox["\[ExponentialE]", "x"]}], ",", "0"}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"yaxis", "=", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "c"}], ",", "c", ",", "h"}], "]"}]}], ";", "   ", 
       "\[IndentingNewLine]", 
       RowBox[{"payoff", "=", 
        RowBox[{
         RowBox[{"V", "/@", "yaxis"}], "//", "N"}]}], ";", "         ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"yaxis", ",", " ", "payoff"}], "}"}], "//", "Transpose"}], 
         "//", "ListPlot"}], " ", "*)"}], 
       RowBox[{"(*", " ", 
        RowBox[{
        "\:5230\:671f\:65e5\:6642", ",", 
         "\:6700\:5f8c\:4e00\:500boption\:7684\:50f9\:503c", ",", 
         "\:8a18\:6210payoff"}], " ", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"glist", "=", 
        RowBox[{
         RowBox[{"g", "/@", "yaxis"}], "//", "N"}]}], ";", "   ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", "+", "1"}], ")"}], 
          "\:500by\:7684\:6a5f\:7387\:5206\:914d\:503c"}], ",", 
         RowBox[{"density", " ", "value"}], ",", "\:8a18\:6210glist"}], " ", 
        "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"value", "=", "payoff"}], ";", "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"k", "=", "1"}], ",", 
         RowBox[{"k", "\[LessEqual]", "n"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"value", "=", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Max", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"value", "[", 
                  RowBox[{"[", "j", "]"}], "]"}], "-", 
                 RowBox[{"Klist", "[", 
                  RowBox[{"[", 
                   RowBox[{"-", "k"}], "]"}], "]"}]}], ",", "0"}], "}"}], 
              "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"Length", "[", "yaxis", "]"}]}], "}"}]}], "]"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"value", "=", 
           RowBox[{
            SuperscriptBox["\[ExponentialE]", 
             RowBox[{
              RowBox[{"-", "r"}], " ", "dt"}]], " ", "h", " ", 
            RowBox[{"Convol", "[", 
             RowBox[{"glist", ",", "value", ",", "ordd"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"k", "++"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"Compoundvalue", "=", 
        RowBox[{"Intp", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"{", 
            RowBox[{"yaxis", ",", "value"}], "}"}], "//", "Transpose"}], ",", 
          " ", 
          RowBox[{"ordd", "-", "1"}], ",", " ", 
          RowBox[{"Log", "[", 
           FractionBox["s0", 
            RowBox[{"Klist", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}]], "]"}]}], "]"}]}], " ", ";", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{"y", "=", 
          RowBox[{"Log", 
           RowBox[{"(", 
