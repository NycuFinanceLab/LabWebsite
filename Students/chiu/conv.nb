Cell[CellGroupData[{

Cell["Lookback", "Section",
 CellChangeTimes->{{3.5405520407402573`*^9, 3.5405520435564184`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"LookBackGBM", "[", 
     RowBox[{
     "s0_", ",", "r_", ",", "\[Sigma]_", ",", "T_", ",", "n_", ",", "c_", ",",
       "m_", ",", "ordd_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "CPUtime", ",", "dt", ",", "h", ",", "g", ",", "V", ",", "xaxis", ",", 
        "yaxis", ",", "payoff", ",", "glist", ",", "value"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"CPUtime", "=", 
        RowBox[{"TimeUsed", "[", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"dt", "=", 
        RowBox[{"T", "/", "n"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"h", "=", 
        FractionBox[
         RowBox[{"2", "c"}], "m"]}], ";", "\[IndentingNewLine]", 
       RowBox[{"xaxis", "=", 
        RowBox[{"Range", "[", 
         RowBox[{"0", ",", "c", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"yaxis", "=", 
        RowBox[{"Range", "[", 
         RowBox[{
          RowBox[{"-", "c"}], ",", "c", ",", "h"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"g", "[", "w_", "]"}], ":=", 
        RowBox[{
         FractionBox["1", 
          RowBox[{"\[Sigma]", 
           SqrtBox[
            RowBox[{"2", "\[Pi]", " ", "dt"}]]}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", 
             RowBox[{"2", "dt"}]]}], 
           SuperscriptBox[
            RowBox[{"(", 
             FractionBox[
              RowBox[{"w", "+", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", "-", 
                  FractionBox[
                   SuperscriptBox["\[Sigma]", "2"], "2"]}], ")"}], " ", 
                "dt"}]}], "\[Sigma]"], ")"}], "2"]}]]}]}], ";", "   ", 
       RowBox[{"(*", " ", "y\:7684\:5206\:914d\:5f62\:5f0f", " ", "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"V", "[", 
         RowBox[{"x_", ",", "y_"}], "]"}], ":=", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"y", "<", "x"}], ",", 
          RowBox[{"s0", 
           RowBox[{"(", 
            RowBox[{
             SuperscriptBox["\[ExponentialE]", "x"], "-", 
             SuperscriptBox["\[ExponentialE]", "y"]}], ")"}]}], ",", "0"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"payoff", "=", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"If", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"i", "\[Equal]", 
               RowBox[{
                FractionBox["m", "2"], "+", "1"}]}], "  ", "&&", " ", 
              RowBox[{"j", "\[Equal]", 
               RowBox[{"i", "-", 
                FractionBox["m", "2"]}]}]}], ",", "0", ",", 
             RowBox[{"V", "[", 
              RowBox[{
               RowBox[{"xaxis", "[", 
                RowBox[{"[", "j", "]"}], "]"}], ",", 
               RowBox[{"yaxis", "[", 
                RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "1", ",", 
             RowBox[{"Length", "[", "yaxis", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"j", ",", "1", ",", 
             RowBox[{"Length", "[", "xaxis", "]"}]}], "}"}]}], "]"}], "//", 
         "Transpose"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"glist", "=", 
        RowBox[{
         RowBox[{"g", "/@", "yaxis"}], "//", "N"}]}], ";", "   ", 
       RowBox[{"(*", " ", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"m", "+", "1"}], ")"}], 
          "\:500by\:7684\:6a5f\:7387\:5206\:914d\:503c"}], ",", 
         RowBox[{"density", " ", "value"}], ",", "\:8a18\:6210glist"}], " ", 
        "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"value", "=", "payoff"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"k", "=", "1"}], ",", 
         RowBox[{"k", "\[LessEqual]", " ", "n"}], ",", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"pa", "=", 
           RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"For", "[", 
           RowBox[{
            RowBox[{"ii", "=", "1"}], ",", 
            RowBox[{"ii", "\[LessEqual]", " ", 
             RowBox[{
              FractionBox["m", "2"], "+", "1"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"va", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"j", "\[LessEqual]", " ", 
                   RowBox[{
                    FractionBox["m", "2"], "+", "ii"}]}], ",", 
                  RowBox[{"value", "[", 
                   RowBox[{"[", 
                    RowBox[{"ii", ",", "j"}], "]"}], "]"}], ",", 
                  RowBox[{"value", "[", 
                   RowBox[{"[", 
                    RowBox[{
                    RowBox[{"j", "-", 
                    FractionBox["m", "2"]}], ",", "j"}], "]"}], "]"}]}], 
                 "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "1", ",", 
                  RowBox[{"m", "+", "1"}]}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"uuu", "=", 
              RowBox[{
               SuperscriptBox["\[ExponentialE]", 
                RowBox[{
                 RowBox[{"-", "r"}], " ", "dt"}]], " ", "h", " ", 
               RowBox[{"Convol", "[", 
                RowBox[{"glist", ",", "va", ",", "ordd"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"AppendTo", "[", 
              RowBox[{"pa", ",", " ", "uuu"}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"ii", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"value", "=", "pa"}], ";", "\[IndentingNewLine]", 
          RowBox[{"k", "++"}], ";"}]}], "\[IndentingNewLine]", "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Lookvalue", "=", 
        RowBox[{"value", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", 
           RowBox[{
            FractionBox["m", "2"], "+", "1"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"m", ",", "Lookvalue", ",", "n", ",", 
          RowBox[{
           RowBox[{"TimeUsed", "[", "]"}], "-", "CPUtime"}]}], "}"}], "//", 
        "Return"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 StyleBox[
