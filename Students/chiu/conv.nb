       RowBox[{
        RowBox[{"Table", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"zeros", "=", 
            RowBox[{"Table", "[", 
             RowBox[{"0", ",", " ", 
              RowBox[{"{", "n", "}"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"zeros", "[", 
             RowBox[{"[", "k", "]"}], "]"}], "=", "1"}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"Integrate", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"InterpolatingPolynomial", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Range", "[", "n", "]"}], ",", " ", "zeros"}], 
                 "}"}], "//", "Transpose"}], ",", " ", "x"}], "]"}], 
             "\[IndentingNewLine]", ",", " ", 
             RowBox[{"{", 
              RowBox[{"x", ",", " ", "1", ",", " ", "j"}], "}"}]}], "]"}]}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "1", ",", "n"}], "}"}]}], "]"}], "//", 
        "Return"}], ";"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"DisConvol", "[", 
     RowBox[{"a_", ",", " ", "b_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"InverseFourier", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Fourier", "[", 
        RowBox[{"PadRight", "[", 
         RowBox[{"a", ",", 
          RowBox[{
           RowBox[{"2", 
