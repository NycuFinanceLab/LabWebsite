     "R", ",", "fu", ",", "mu", ",", "mb", ",", "Y", ",", "pf", ",", "mb", 
     ",", "ma", ",", "rec", ",", "va", ",", "vb", ",", " ", "rawx", ",", 
     "ExpBraw", ",", "ExpYraw", ",", " ", "x", ",", " ", "terms", ",", " ", 
     "terms1"}], "]"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"<<", "LinearAlgebra`MatrixManipulation`"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"MyPlot", "[", "list_", "]"}], ":=", 
    RowBox[{"ListPlot", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"xaxis", ",", "list"}], "}"}], "]"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotRange", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"0", ",", "20"}], "}"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotJoined", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"Hue", "[", ".6", "]"}]}], ",", "\[IndentingNewLine]", 
      RowBox[{"ImageSize", "\[Rule]", "400"}]}], "\[IndentingNewLine]", 
     "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Intp", "[", 
     RowBox[{"tab_", ",", "ord_", ",", "x_"}], "]"}], ":=", 
    RowBox[{"Block", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"c", ",", "d", ",", "m1", ",", "i"}], "}"}], ",", 
      StyleBox[
       RowBox[{"(*", " ", 
        RowBox[{"ord", "=", 
         RowBox[{"1", " ", "\:662f\:7dda\:6027\:5167\:63d2"}]}], " ", "*)"}],
       FontColor->RGBColor[1, 0, 0]], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"c", "=", 
        RowBox[{"tab", "\[LeftDoubleBracket]", 
         RowBox[{"1", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"d", "=", 
        RowBox[{"tab", "\[LeftDoubleBracket]", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"m1", "=", 
        RowBox[{
         RowBox[{"Length", "[", "tab", "]"}], "-", "1"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"c", "\[LessEqual]", "x", "\[LessEqual]", "d"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"i", "=", 
           RowBox[{"Floor", "[", 
            RowBox[{"1", "+", 
             FractionBox[
              RowBox[{"m1", 
               RowBox[{"(", 
                RowBox[{"x", "-", "c"}], ")"}]}], 
              RowBox[{"d", "-", "c"}]]}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"i", "+", "ord"}], ">", 
             RowBox[{"m1", "+", "1"}]}], ",", "\[IndentingNewLine]", 
            RowBox[{"Return", "[", 
             RowBox[{
              RowBox[{"InterpolatingPolynomial", "[", 
               RowBox[{
                RowBox[{"tab", "\[LeftDoubleBracket]", 
                 RowBox[{"Range", "[", 
                  RowBox[{
                   RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"ord", "+", "1"}], ")"}]}], ",", 
                   RowBox[{"-", "1"}]}], "]"}], "\[RightDoubleBracket]"}], 
                ",", "t"}], "]"}], "/.", "\[InvisibleSpace]", 
              RowBox[{"t", "\[Rule]", "x"}]}], "]"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"i", "=", 
              RowBox[{"i", "-", 
               RowBox[{"Mod", "[", 
                RowBox[{
                 RowBox[{"i", "-", "1"}], ",", "ord"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Return", "[", 
              RowBox[{
               RowBox[{"InterpolatingPolynomial", "[", 
                RowBox[{
                 RowBox[{"tab", "\[LeftDoubleBracket]", 
                  RowBox[{"Range", "[", 
                   RowBox[{"i", ",", 
                    RowBox[{"i", "+", "ord"}]}], "]"}], 
                  "\[RightDoubleBracket]"}], ",", "t"}], "]"}], "/.", 
               "\[InvisibleSpace]", 
               RowBox[{"t", "\[Rule]", "x"}]}], "]"}]}]}], "]"}]}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{
          RowBox[{"Return", "[", "0", "]"}], ";"}]}], "\[IndentingNewLine]", 
        "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Ncdf", "[", "x_", "]"}], ":=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{"1", "+", 
      RowBox[{"Erf", "[", 
       FractionBox["x", 
        SqrtBox["2"]], "]"}]}], ")"}]}]}], ";"}]}], "Input"],

